Ddoc

$(SPEC_S Templates,

$(HEADERNAV_TOC)

$(LASER_NORMATIVE Templates are part of Laser-D's compile-time programming
model. Type, value, alias, and sequence parameters; overload selection;
specialization; constraints; explicit and inferred instantiation; recursion;
and cross-module instance emission are supported.)

$(P A template operates on already parsed declarations and expressions. It
does not create an exception to any Laser-D language rule: every declaration,
type, expression, and statement produced by an instance must itself be valid
Laser-D.)

$(H2 $(LNAME2 declarations, Template Declarations))

$(GRAMMAR
$(GNAME TemplateDeclaration):
    $(D template) $(GLINK_LEX Identifier) $(GLINK TemplateParameters) $(GLINK Constraint)$(OPT) $(D {) $(GLINK2 module, DeclDefs)$(OPT) $(D })

$(GNAME TemplateParameters):
    $(D $(LPAREN)) $(GLINK TemplateParameterList)$(OPT) $(D $(RPAREN))

$(GNAME TemplateParameterList):
    $(GLINK TemplateParameter)
    $(GLINK TemplateParameter) $(D ,) $(GSELF TemplateParameterList)
)

$(P A named template introduces a scope containing its parameters and body.
The body may contain supported aliases, manifest constants, functions,
structs, unions, enums, and further templates.)

$(D_CODE
template Pointer(T)
{
    alias Pointer = T*;
}

static assert(is(Pointer!int == int*));
)

$(P Multiple templates may share a name and form an overload set when their
parameters, specializations, or constraints distinguish them.)

$(H2 $(LNAME2 template_instantiation, Template Instantiation))

$(H3 $(LNAME2 explicit_tmp_instantiation, Explicit Instantiation))

$(GRAMMAR
$(GNAME TemplateInstance):
    $(GLINK_LEX Identifier) $(D !) $(GLINK TemplateArguments)

$(GNAME TemplateArguments):
    $(D $(LPAREN)) $(GLINK TemplateArgumentList)$(OPT) $(D $(RPAREN))
    $(GLINK TemplateSingleArgument)

$(GNAME TemplateArgumentList):
    $(GLINK TemplateArgument)
    $(GLINK TemplateArgument) $(D ,) $(GSELF TemplateArgumentList)
)

$(P $(D Name!(arguments)) explicitly selects and instantiates a matching
template. The short $(D Name!argument) form is available where the D grammar
accepts a single unambiguous argument.)

$(P Arguments are resolved at compile time. A failure to find one uniquely
best matching declaration is a compile-time error.)

$(H3 $(LNAME2 common_instantiation, Instance Identity))

$(P Instantiating the same template declaration with equivalent arguments
denotes the same semantic instance. The compiler may share generated code and
data according to the normal linkage and emission rules.)

$(H3 $(LNAME2 instantiation_scope, Scope))

$(P Names in the template declaration are resolved in their lexical scope.
Names supplied as template arguments retain their symbol identity. An
instantiation does not gain access to an enclosing runtime value unless the
instantiated declaration is otherwise permitted to carry that context;
Laser-D rejects hidden-context structs and named nested functions.)

$(H2 $(LNAME2 parameters, Template Parameters))

$(GRAMMAR
$(GNAME TemplateParameter):
    $(GLINK TemplateTypeParameter)
    $(GLINK TemplateThisParameter)
    $(GLINK TemplateValueParameter)
    $(GLINK TemplateAliasParameter)
    $(GLINK TemplateSequenceParameter)
)

$(P A parameter may have a specialization, a default argument, or both where
allowed by its parameter kind. Defaults are evaluated in the declaration's
scope.)

$(H3 $(LNAME2 template_type_parameters, Type Parameters))

$(P A type parameter accepts a supported Laser-D type. It may be specialized
to another type or pattern and may have a supported default type.)

$(D_CODE
template Element(T : T*)
{
    alias Element = T;
}

static assert(is(Element!(int*) == int));
)

$(P Pattern deduction may bind additional identifiers appearing in the
specialization. A rejected type cannot be introduced merely because a template
could describe its pattern.)

$(H3 $(LNAME2 template_this_parameter, Template $(D this) Parameters))

$(LASER_SUPPORTED A template $(D this) parameter on a struct or union member
may infer the receiver type. It can distinguish mutable and immutable
receivers using the supported type system.)

$(P It does not add an outer object reference, inheritance, a hidden context,
or class/interface behavior. The instantiated member remains subject to the
ordinary receiver and function rules.)

$(H3 $(LNAME2 template_value_parameter, Value Parameters))

$(P A value parameter has a declared supported type and receives a value that
is known at compile time. It may have a value specialization and default.)

$(D_CODE
template PowerOfTwo(uint exponent)
{
    enum PowerOfTwo = 1u << exponent;
}

static assert(PowerOfTwo!5 == 32);
)

$(P Values used as template arguments must be representable and valid for
compile-time evaluation. Runtime addresses or values with unsupported types do
not become valid template arguments.)

$(H3 $(LNAME2 aliasparameters, Alias Parameters))

$(P An alias parameter accepts a symbol, type, template, or compile-time value
that is valid for alias binding. It preserves the identity of a symbol rather
than copying its runtime value.)

$(D_CODE
int increment(int value)
{
    return value + 1;
}

template Apply(alias operation, int value)
{
    enum Apply = operation(value);
}

static assert(Apply!(increment, 4) == 5);
)

$(P Alias parameters may be specialized, constrained, or given defaults.
Binding a rejected declaration does not make that declaration usable.)

$(H3 $(LNAME2 variadic-templates, Sequence Parameters))

$(P A final parameter written $(D Name...) accepts a compile-time sequence of
zero or more types, values, aliases, or mixtures accepted by the declaration.)

$(D_CODE
template Count(Items...)
{
    enum Count = Items.length;
}

static assert(Count!(int, long, 7) == 3);
)

$(P A sequence supports compile-time length, indexing, slicing, expansion, and
iteration by supported compile-time constructs. It is not a runtime dynamic
array, does not allocate, and does not enable D runtime variadic functions.)

$(P A sequence parameter must be last. Function-template deduction may collect
remaining matching arguments into it.)

$(H3 $(LNAME2 template_parameter_def_values, Default Arguments))

$(P Omitted template arguments use their declared defaults after earlier
parameters have been bound. A default may depend on an earlier parameter but
must itself produce a supported argument.)

$(H2 $(LNAME2 selection, Selection and Specialization))

$(P Template selection considers parameter kinds, explicit specializations,
deduced patterns, constraints, and overload ordering. The uniquely most
specialized viable declaration is selected.)

$(P Specializations may distinguish supported type structure, compile-time
values, aliases, and sequence shapes. Class inheritance and interface
conversion do not participate because those type families are unavailable.)

$(H2 $(LNAME2 template_constraints, Template Constraints))

$(GRAMMAR
$(GNAME Constraint):
    $(D if $(LPAREN)) $(GLINK2 expression, Expression) $(D $(RPAREN))
)

$(P A constraint is evaluated at compile time after enough parameters have
been bound to evaluate it. A true constraint makes that candidate viable; a
false constraint removes it from the overload set.)

$(D_CODE
T larger(T)(T left, T right)
    if (is(T == int) || is(T == long))
{
    return left > right ? left : right;
}

static assert(larger(10, 20) == 20);
)

$(P Constraints may use supported $(D is), $(D typeof), $(D __traits), CTFE,
and template facilities. They cannot perform compile-time file I/O, inject
source text, or rely on a rejected runtime service.)

$(H2 $(LNAME2 implicit_template_properties, Eponymous Templates))

$(P When a template contains a member with the same name, selecting the
template may directly denote that member. This supports type aliases, manifest
values, and other compile-time results.)

$(D_CODE
template Identity(T)
{
    alias Identity = T;
}

static assert(is(Identity!int == int));
)

$(H2 $(LNAME2 aggregate_templates, Aggregate Templates))

$(P Struct and union templates are supported. Their fields, methods,
constructors, operators, storage, and nesting must satisfy the corresponding
Laser-D aggregate rules.)

$(D_CODE
struct Pair(First, Second = First)
{
    First first;
    Second second;
}

static assert(is(typeof(Pair!(int, long).second) == long));
)

$(LASER_EXCLUDED Class and interface templates are rejected because class and
interface declarations are not part of Laser-D. An aggregate template cannot
restore destructors, postblits, copy or move constructors, invariants,
$(D alias this), hidden contexts, or C++ struct linkage.)

$(H2 $(LNAME2 function-templates, Function Templates))

$(P A function template places template parameters before its ordinary
function parameters. It may be instantiated explicitly or inferred from the
call arguments.)

$(H3 $(LNAME2 ifti, Implicit Function Template Instantiation))

$(P IFTI deduces template parameters from the types and values of explicit
function arguments, applies defaults, checks constraints, and selects a unique
viable instance. Normal supported conversions occur only after deduction where
the D matching rules allow them.)

$(H3 $(LNAME2 return-deduction, Return-Type Deduction))

$(P An omitted function result type may be inferred from supported return
expressions. Deduction cannot produce a rejected type or a reference result.)

$(LASER_EXCLUDED Template functions cannot use $(D auto ref) parameters or
returns. Parameters are limited to the separately supported Laser-D parameter
forms, and reference return values are rejected.)

$(H2 $(LNAME2 template_ctors, Template Constructors))

$(P A supported struct may declare a templated constructor, and a struct
template may declare an ordinary constructor. Construction initializes the
destination in place through compiler-internal lowering; it does not expose a
source-level reference return.)

$(P Constructor delegation, class construction, destructors, postblits, and
copy or move constructors remain rejected.)

$(H2 $(LNAME2 variable-template, Enum and Variable Templates))

$(P Manifest enum templates and supported variable templates may depend on
template parameters. Any instantiated storage must follow the Laser-D global
and static-storage rules; a template does not permit mutable global state.)

$(D_CODE
enum doubled(int value) = value * 2;

static assert(doubled!21 == 42);
)

$(H2 $(LNAME2 alias-template, Alias Templates))

$(P An alias template computes a type, symbol, template, or supported
compile-time value without introducing runtime storage.)

$(D_CODE
alias Pointer(T) = T*;

static assert(is(Pointer!int == int*));
)

$(H2 $(LNAME2 nested-templates, Nested Templates))

$(P Templates may be nested in supported modules, templates, structs, unions,
and functions where their instantiated declarations require no rejected hidden
runtime context. Lexical nesting affects name lookup but does not by itself
create a closure or outer aggregate pointer.)

$(H2 $(LNAME2 recursive_templates, Recursive Templates))

$(P A template may instantiate itself directly or indirectly when each
instantiation makes finite progress toward a terminating specialization or
constraint. Non-terminating or excessively deep instantiation is diagnosed by
the compiler's implementation limits.)

$(D_CODE
template Factorial(uint value)
{
    enum Factorial = value * Factorial!(value - 1);
}

template Factorial(uint value : 0)
{
    enum Factorial = 1;
}

static assert(Factorial!5 == 120);
)

$(H2 $(LNAME2 emission, Instance Emission))

$(LASER_NORMATIVE Template instances required by a root module are emitted
without relying on the D runtime. Instances used across separately compiled
modules retain the normal symbol identity, linkage, and duplicate-elimination
rules of the unchanged frontend/backend interface.)

$(P Emission does not make an otherwise rejected declaration linkable.
Instantiated code must use supported functions, storage, types, and foreign
interfaces.)

$(H2 $(LNAME2 compile-time, Compile-Time Evaluation))

$(P Templates compose with CTFE, $(D static if), $(D static foreach),
$(D static assert), $(D typeof), $(D is), and the supported $(D __traits)
operations. Template arguments, constraints, initializers, and manifest values
may invoke supported CTFE functions.)

$(P $(D __ctfe) remains available to distinguish compile-time execution inside
a function. Compile-time execution does not grant additional language
capabilities.)

$(H2 $(LNAME2 restrictions, Cross-Cutting Restrictions))

$(LASER_EXCLUDED A template, constraint, or CTFE evaluation cannot restore:)

$(UL
$(LI string mixin declarations, statements, expressions, or types,)
$(LI compile-time import expressions or other compile-time file I/O,)
$(LI classes, interfaces, associative arrays, vectors, or rejected scalar
types,)
$(LI GC-backed allocation, array growth, or capturing delegates,)
$(LI exceptions, contracts, or unit-test blocks,)
$(LI user-defined attributes, rejected qualifiers, or rejected parameter and
return annotations,)
$(LI runtime type metadata, module lifecycle, global mutable state, threading
features, or inline assembly.)
)

$(P $(D __traits(compiles)) may probe whether code follows these rules, but a
successful enclosing template declaration does not defer or suppress a
diagnostic for an actually instantiated rejected construct.)

$(SPEC_SUBNAV_PREV_NEXT operatoroverloading, Operator Overloading, template-mixin, Template Mixins)
)

Macros:
CHAPTER=22
TITLE=Templates
_=
