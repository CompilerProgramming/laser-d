Ddoc

$(SPEC_S Memory Management,

$(HEADERNAV_TOC)

$(LASER_NORMATIVE Laser-D has no garbage collector and no D runtime memory
manager. The language does not implicitly allocate, trace, retain, resize, or
free program storage. Storage duration and ownership must be visible in the
program or defined by an explicitly called foreign API.)

$(H2 $(LNAME2 storage, Supported Storage))

$(P Laser-D programs may use:)

$(UL
$(LI automatic local variables and fixed-size arrays,)
$(LI fields and inline fixed-size arrays within supported structs and unions,)
$(LI immutable data in static storage, including string-literal backing
storage,)
$(LI caller-provided storage accessed through pointers or non-owning slices,)
$(LI storage returned by an explicitly declared C or other supported foreign
function.)
)

$(P Mutable D-owned global and static storage is rejected by the separate
global-state rules. ImportC retains the C storage model.)

$(H2 $(LNAME2 slices, Slices Are Non-Owning Views))

$(P A dynamic-array type $(D T[]) is supported only as a pointer-and-length
view. A slice does not own its elements, keep their storage alive, record a
capacity, or arrange for deallocation. Copying a slice copies only the view.)

$(P The programmer must ensure that a slice is not used after its backing
storage expires or is released. Returning a slice into automatic local storage
is invalid even though no garbage collector is involved.)

$(H2 $(LNAME2 excluded, Excluded Implicit Allocation))

$(LASER_EXCLUDED The following D facilities are not part of Laser-D because
they allocate implicitly or depend on garbage-collector metadata:)

$(UL
$(LI every $(D new) expression, including placement and array forms,)
$(LI dynamic-array and associative-array literals,)
$(LI associative-array types and operations,)
$(LI built-in array concatenation with $(D ~) or $(D ~=),)
$(LI $(D .dup), $(D .idup), and $(D .capacity),)
$(LI appending to an array and assigning to a dynamic-array $(D .length),)
$(LI closure capture and hidden heap-allocated delegate contexts,)
$(LI $(D __traits(getPointerBitmap)) and other GC scanning metadata.)
)

$(P String literals are not dynamic-array allocations. Their immutable backing
storage is supplied by the compiled program, and the resulting slice remains a
non-owning view.)

$(H2 $(LNAME2 explicit-allocation, Explicit Allocation))

$(P A program may call an explicitly declared foreign allocator such as a C
runtime or platform API. Such a call is an ordinary visible function call; it
is not a Laser-D language allocation facility.)

$(D_CODE
extern(C) void* malloc(size_t size);
extern(C) void free(void* address);

void useStorage()
{
    void* storage = malloc(256);
    if (storage is null)
    {
        // handle allocation failure
        return;
    }
    scope(exit) free(storage);

    // use storage
}
)

$(P The allocator's contract determines alignment, lifetime, failure handling,
threading behavior, and the matching release operation. Laser-D does not add
ownership tracking or automatically call $(D free). A pointer or slice derived
from released storage becomes invalid.)

$(H2 $(LNAME2 cleanup, Cleanup and Resource Ownership))

$(P Cleanup is explicit. Programs may use ordinary control flow and
$(D scope(exit)) to ensure that a visible release function is called.
Struct destructors, class finalizers, exceptions, and garbage-collector finalizers
are unavailable.)

$(P A program must define who owns allocated storage, when ownership transfers,
and which operation releases it. The compiler does not diagnose leaks,
double-release errors, dangling pointers, or use after release.)

$(H2 $(LNAME2 interoperability, Interoperability))

$(P Pointers may cross a supported foreign-function boundary according to that
API's ABI and ownership contract. A Laser-D slice passed to foreign code is
represented by its pointer and length only when the declared interface
explicitly uses that representation; it is not implicitly a C array or an
owning foreign container.)

$(SPEC_SUBNAV_PREV_NEXT unittest, Unit Tests, float, Floating Point)
)

