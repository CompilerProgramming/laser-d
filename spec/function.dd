Ddoc

$(SPEC_S Functions,

$(HEADERNAV_TOC)

$(P Laser-D supports ordinary functions, struct methods, function pointers,
non-capturing function and delegate literals, non-capturing delegates, and
delegates to struct methods. Functions use an explicit, runtime-free calling
model and remain subject to every Laser-D type and storage restriction.)

$(H2 $(LNAME2 grammar, Function Declarations))

$(GRAMMAR
$(GNAME FunctionDeclaration):
    $(GLINK2 type, Type) $(GLINK_LEX Identifier) $(GLINK Parameters) $(GLINK FunctionBody)
    $(D auto) $(GLINK_LEX Identifier) $(GLINK Parameters) $(GLINK FunctionBody)

$(GNAME Parameters):
    $(D $(LPAREN) $(RPAREN))
    $(D $(LPAREN)) $(GLINK ParameterList) $(D $(RPAREN))

$(GNAME ParameterList):
    $(GLINK Parameter)
    $(GLINK Parameter) $(D ,) $(GSELF ParameterList)

$(GNAME Parameter):
    $(GLINK ParameterStorageClass)$(OPT) $(GLINK2 type, Type) $(GLINK_LEX Identifier)$(OPT)
    $(GLINK ParameterStorageClass)$(OPT) $(GLINK2 type, Type) $(GLINK_LEX Identifier)$(OPT) $(D =) $(ASSIGNEXPRESSION)

$(GNAME ParameterStorageClass):
    $(D in)
    $(D out)
    $(D ref)

$(GNAME FunctionBody):
    $(D ;)
    $(GLINK2 statement, BlockStatement)
)

$(H3 Function Parameters)

$(P Parameters are evaluated and matched from left to right according to the
ordinary call and overload rules. A parameter with no storage-class annotation
is passed by value. The only permitted source annotations are $(D in), $(D out),
and $(D ref).)

$(LASER_REJECTED Parameter annotations $(D scope), $(D lazy), $(D return),
$(D inout), and $(D shared), together with combinations derived from them, are
rejected. User-defined parameter attributes are also rejected.)

$(H3 $(LNAME2 attributes, Function Model and Attributes))

$(LASER_NORMATIVE Every Laser-D function and function type is implicitly
$(D nothrow), $(D @nogc), and $(D @system). These properties apply to ordinary
functions, external declarations, methods, pointers, delegates, literals,
templates, inferred functions, and frontend-generated helpers.)

$(P The implicit attributes are language invariants and are not written in
source. Attribute inference cannot weaken or strengthen them.)

$(LASER_REJECTED Explicit $(D nothrow), $(D @nogc), $(D @system), $(D @safe),
$(D @trusted), $(D pure), $(D @live), $(D @property), and $(D @disable) are
rejected. Function contracts and user-defined attributes are rejected
separately below.)

$(P A struct method may use an $(D immutable) receiver. The rejected $(D const),
$(D inout), and $(D shared) receiver qualifiers are unavailable.)

$(H3 $(LNAME2 function-bodies, Function Bodies))

$(P A function definition has a normal block body. Its statements and local
declarations must use supported Laser-D constructs.)

$(LASER_REJECTED Contract-style $(D do) bodies, expression and block contracts,
and body syntax belonging to rejected function facilities are not supported.)

$(H3 $(LNAME2 function-declarations, Function Prototypes))

$(P A declaration ending in $(D ;) introduces a function without defining its
body. This is used for separate compilation and C or supported C++ free-function
interoperability. The declaration's type must match its definition and ABI.)

$(H2 $(LNAME2 contracts, Function Contracts))

$(H3 $(LNAME2 preconditions, Preconditions))

$(LASER_REJECTED Function $(D in) contract blocks and expressions are rejected.
The parameter annotation $(D in) is a distinct, supported parameter feature.)

$(H3 $(LNAME2 postconditions, Postconditions))

$(LASER_REJECTED Function $(D out) contract blocks, result identifiers, and
contract-style $(D do) bodies are rejected. The parameter annotation $(D out)
is a distinct, supported parameter feature.)

$(P Preconditions and postconditions may be expressed as ordinary explicitly
called functions when desired.)

$(H2 $(LNAME2 function-return-values, Function Return Values))

$(P A function may return $(D void) or a supported value type. A value-returning
function uses $(D return expression;); a void function uses $(D return;) or
reaches the end of its body where permitted.)

$(P Returning fixed arrays, structs, unions, enums, pointers, non-owning slices,
function pointers, and delegates follows their respective value and lifetime
rules. A returned slice or pointer does not acquire ownership or an extended
lifetime.)

$(LASER_REJECTED Source-level $(D ref) return values are rejected, including
$(D auto ref), explicit constructor return annotations, and reference-returning
operator hooks. Return annotations on parameters are also rejected.)

$(H2 $(LNAME2 pure-functions, Purity))

$(LASER_REJECTED Laser-D does not expose D's explicit or inferred $(D pure)
function property. Functions remain conservatively impure so calls to C and
explicitly managed state require no qualifier escape.)

$(H3 $(LNAME2 weak-purity, Purity Categories))

$(P D's weak/strong purity distinction is not part of Laser-D.)

$(H3 $(LNAME2 pure-special-cases, Purity Special Cases))

$(P No special pure-function conversions or optimizations form part of the
Laser-D language contract.)

$(H4 $(LNAME2 pure-debug, Debugging Pure Functions))

$(P This upstream facility is unavailable because $(D pure) is rejected.)

$(H3 $(LNAME2 pure-nested, Pure Nested Functions))

$(P This upstream facility is unavailable because $(D pure) is rejected.)

$(H3 $(LNAME2 pure-factory-functions, Pure Factory Functions))

$(P This upstream facility is unavailable because $(D pure) and implicit
allocation are rejected.)

$(H3 $(LNAME2 pure-optimization, Purity Optimizations))

$(P Backend optimizations do not create source-visible purity guarantees.)

$(H2 $(LNAME2 nothrow-functions, Non-Throwing Functions))

$(P Every function is implicitly non-throwing because D exceptions and
$(D throw) are rejected. The $(D nothrow) keyword cannot be written explicitly.)

$(H2 $(LNAME2 ref-functions, Reference-Returning Functions))

$(LASER_REJECTED Reference-returning functions are rejected. Functions return
values, pointers, or non-owning slices when caller-visible access is required.)

$(H2 $(LNAME2 auto-functions, Inferred Return Types))

$(P A function declared with $(D auto) may infer its value return type from all
reachable return expressions. Every inferred type must be supported and the
returns must have a common compatible type.)

$(H2 $(LNAME2 auto-ref-functions, Inferred Reference Returns))

$(LASER_REJECTED $(D auto ref) and every inferred or explicit reference return
are rejected.)

$(H2 $(LNAME2 inout-functions, Inout Functions))

$(LASER_REJECTED $(D inout) functions, receivers, parameters, returns, and
wildcard qualifier matching are rejected.)

$(H2 $(LNAME2 optional-parenthesis, Optional Parentheses))

$(LASER_REJECTED Function and method calls always require explicit
parentheses, including zero-argument functions and functions whose parameters
all have default arguments.)

$(H2 $(LNAME2 property-functions, Property Functions))

$(LASER_REJECTED User-defined $(D @property) functions and property-style
getter/setter calls are rejected. Executable source-defined behavior must look
like an explicit call.)

$(H2 $(LNAME2 virtual-functions, Virtual Functions))

$(LASER_REJECTED Virtual functions are unavailable because classes and
interfaces are rejected. Struct methods use static dispatch and have no hidden
virtual-function table.)

$(H3 $(LNAME2 final, Final Functions))

$(P Class/interface $(D final) semantics are unavailable. Any remaining
declaration use of $(D final) is governed by the attribute review and is not
implied by support for ordinary functions.)

$(H3 $(LNAME2 covariance, Covariant Returns))

$(P Class and interface return covariance is unavailable with those object
models.)

$(H3 $(LNAME2 base-methods, Base Methods))

$(P There are no base methods or $(D super) calls in Laser-D.)

$(H3 $(LNAME2 function-inheritance, Inherited Overloads))

$(P Function inheritance and overriding are unavailable. Free-function and
struct-method overload sets remain ordinary static overloads.)

$(H3 $(LNAME2 override-defaults, Overridden Default Arguments))

$(P Overriding is unavailable. Defaults on ordinary overloads are resolved at
the selected declaration.)

$(H3 $(LNAME2 inheriting-attributes, Inherited Attributes))

$(P There is no class/interface attribute inheritance.)

$(H3 $(LNAME2 override-restrictions, Override Restrictions))

$(P Override-specific restrictions are unavailable because overriding is
unavailable.)

$(H2 $(LNAME2 inline-functions, Inlining))

$(P Inlining is a compiler optimization and does not change Laser-D semantics.
Source controls for forcing or preventing inlining remain governed by the
pragma and attribute reviews.)

$(H2 $(LNAME2 function-overloading, Function Overloading))

$(P Free functions and struct methods may share a name when their parameter
types or supported qualifiers allow overload resolution to select one unique
candidate. Return type alone does not distinguish overloads.)

$(H3 $(LNAME2 overload-sets, Overload Sets))

$(P Imports, aliases, templates, and local declarations form overload sets under
their respective scope rules. A call that has no unique best supported match is
rejected.)

$(H2 $(LNAME2 parameters, Function Parameters))

$(H3 $(LNAME2 param-storage, Parameter Storage Classes))

$(P The only parameter storage-class annotations are $(D in), $(D out), and
$(D ref). An omitted annotation passes a normal value.)

$(H3 $(LNAME2 in-params, `in` Parameters))

$(P An $(D in) parameter is an input parameter. It cannot be used to return a
replacement value to the caller. Its exact ABI passing strategy is selected by
the compiler without changing source semantics.)

$(H3 $(LNAME2 ref-params, `ref` and `out` Parameters))

$(P A $(D ref) parameter aliases an initialized caller lvalue. An $(D out)
parameter aliases caller storage for an output value and initializes that
storage according to the parameter rules before the function body uses it.)

$(P Both forms require a compatible caller lvalue and do not allocate or extend
its lifetime.)

$(H3 $(LNAME2 lazy-params, Lazy Parameters))

$(LASER_REJECTED $(D lazy) parameters are rejected. They introduce implicit
deferred calls and delegate machinery.)

$(H3 $(LNAME2 function-default-args, Default Arguments))

$(P A parameter may have a compile-time-valid default expression. The expression
is evaluated at the call site when that argument is omitted. The call must
still include parentheses.)

$(H3 $(LNAME2 return-ref-parameters, Return-Ref Parameters))

$(LASER_REJECTED $(D return), $(D return ref), and equivalent parameter
annotations are rejected.)

$(H4 $(LNAME2 struct-return-methods, Struct Return Methods))

$(P Struct methods may return supported values, pointers, or slices but not
references.)

$(H3 $(LNAME2 scope-parameters, Scope Parameters))

$(LASER_REJECTED Explicit and inferred source $(D scope) parameters are not part
of Laser-D's function interface.)

$(H3 $(LNAME2 return-scope-parameters, Return-Scope Parameters))

$(LASER_REJECTED $(D return scope) parameters are rejected.)

$(H3 $(LNAME2 ref-return-scope-parameters, Ref Return-Scope Parameters))

$(LASER_REJECTED Combined $(D ref), $(D return), and $(D scope) lifetime
annotations are rejected.)

$(H3 $(LNAME2 pure-scope-inference, Scope Inference))

$(P Laser-D does not expose purity-based or safety-based scope inference as a
source function property.)

$(H3 $(LNAME2 udas-parameters, Parameter Attributes))

$(LASER_REJECTED User-defined attributes on parameters are rejected.)

$(H3 $(LNAME2 variadic, Variadic Functions))

$(LASER_UNDER_REVIEW Variadic functions require a separate ABI and runtime
review. No variadic form is guaranteed merely because the parser accepts it.)

$(H4 $(LNAME2 c_style_variadic_functions, C-Style Variadic Functions))

$(P C variadics are expected to matter for C interoperability but require
target ABI tests before becoming a Laser-D guarantee.)

$(H4 $(LNAME2 d_style_variadic_functions, D-Style Variadic Functions))

$(P D runtime variadics remain under review and cannot rely on TypeInfo.)

$(H4 $(LNAME2 typesafe_variadic_functions, Typesafe Variadic Functions))

$(P Typesafe runtime variadics remain under review. Variadic template parameters
are a separate, supported compile-time template feature.)

$(H4 $(LNAME2 lazy_variadic_functions, Lazy Variadic Functions))

$(P Lazy variadics are incompatible with the rejection of lazy parameters and
implicit capturing delegates, but their final diagnostic boundary remains part
of the variadic review.)

$(H3 $(LNAME2 hidden-parameters, Hidden Parameters))

$(P Struct methods receive their object context, and delegates contain an
explicit context pointer as part of the delegate value. Laser-D rejects class
context, closure capture, hidden-context nested structs, and hidden lifetime or
TypeInfo parameter protocols.)

$(H2 $(LNAME2 refscopereturn, Ref/Scope/Return Classification))

$(H3 $(LNAME2 rsr_definitions, Definitions))
$(H3 $(LNAME2 rsr_classification, Classification))
$(H3 $(LNAME2 rsr_mapping, Syntax Mapping))
$(H3 $(LNAME2 rsr_memberfunctions, Member Functions))
$(H3 $(LNAME2 rsr_PandRef, Pointer and Reference Cases))
$(H3 $(LNAME2 rsr_covariance, Variance))

$(LASER_REJECTED D's ref/scope/return lifetime-classification system is not a
Laser-D source feature. The anchors above are retained for links from excluded
upstream chapters.)

$(H2 $(LEGACY_LNAME2 Local Variables, local-variables, Local Variables))

$(P Function-local variables use automatic storage unless explicitly provided
through supported external/manual storage. Their initialization and cleanup use
the ordinary declaration and statement rules.)

$(H3 $(LEGACY_LNAME2 Local Static Variables, local-static-variables, Local Static Variables))

$(LASER_REJECTED Mutable function-static storage is rejected. Eligible deeply
immutable static values remain governed by the declaration and qualifier
chapters.)

$(H2 $(LNAME2 nested, Named Nested Functions))

$(LASER_REJECTED Named functions declared inside another function are rejected,
including capturing, context-free, and $(D static) forms. Use a module-level
helper or a non-capturing function literal.)

$(H3 $(LNAME2 nested-qualifiers, Nested Function Qualifiers))

$(P Nested functions cannot restore rejected qualifiers or attributes.)

$(H3 $(LNAME2 nested-declaration-order, Nested Declaration Order))

$(P Nested-function declaration order is unavailable because named nested
functions are rejected.)

$(H2 $(LNAME2 function-pointers-delegates, Function Pointers and Delegates))

$(H3 $(LNAME2 function-pointers, Function Pointers))

$(P A function pointer stores a callable code address with a compatible
function type. Taking the address of a free function, assigning a non-capturing
function literal, passing the pointer, and calling it with explicit parentheses
are supported.)

$(H3 $(LNAME2 closures, Delegates and Closures))

$(P A delegate stores a context pointer and function pointer. Non-capturing
delegate literals are supported and have no captured lexical state.)

$(LASER_REJECTED A function or delegate literal that captures a local variable
is rejected. Named nested functions are rejected separately. Laser-D does not
allocate or preserve closure frames.)

$(H3 $(LNAME2 method-delegates, Method Delegates))

$(P A delegate to a struct method is supported. Its context explicitly identifies
the struct value on which the method operates; this is not lexical closure
capture.)

$(H3 $(LNAME2 function-pointer-attributes, Function-Type Attributes))

$(P Function pointer and delegate types carry the same implicit $(D nothrow),
$(D @nogc), and $(D @system) invariants as declarations. Explicit spellings and
rejected attributes are diagnosed.)

$(H3 $(LNAME2 function-delegate-init, Pointer and Delegate Initialization))

$(P Null initialization, compatible assignment, address-taking, and supported
explicit conversions follow the normal type rules. A null pointer or delegate
cannot be called validly.)

$(H3 $(LNAME2 anonymous, Function and Delegate Literals))

$(P Non-capturing function literals, lambdas, and delegate literals are
supported. Their parameter, return, body, and attribute surface is the same
restricted Laser-D function surface.)

$(H2 $(LNAME2 main, Program Entry Point))

$(LASER_UNDER_REVIEW The complete D $(D main) wrapper and generated entry-point
surface requires separate review. Laser-D tests currently use an explicit
$(D extern(C) int main()) entry point compatible with the C runtime.)

$(H2 $(LNAME2 function-templates, Function Templates))

$(P Function templates, inference, specialization, and constraints are
supported by the template chapter. Every instantiated function must obey this
chapter.)

$(H2 $(LNAME2 interpretation, Compile-Time Function Execution))

$(P Supported functions may execute during CTFE. CTFE does not relax any
Laser-D restriction and cannot perform compile-time file I/O or output.)

$(H3 $(LNAME2 string-mixins, CTFE and String Mixins))

$(LASER_REJECTED CTFE may compute strings as values but cannot reparse them as
source through a string mixin.)

$(H2 $(LNAME2 nogc-functions, No-GC Functions))

$(P Every function is implicitly $(D @nogc). The attribute cannot be written,
and no function may use an operation requiring GC allocation.)

$(H2 $(LNAME2 function-safety, Function Safety))

$(P Every function is implicitly $(D @system). Laser-D does not provide D's
checked memory-safety subset or trusted boundary.)

$(H3 $(LNAME2 safe-functions, Safe Functions))
$(LASER_REJECTED Explicit or inferred $(D @safe) functions are rejected.)

$(H4 Safe External Functions)
$(P External functions remain implicitly $(D @system).)

$(H3 $(LNAME2 trusted-functions, Trusted Functions))
$(LASER_REJECTED $(D @trusted) functions are rejected.)

$(H3 $(LNAME2 system-functions, System Functions))
$(P All functions are implicitly system functions; explicit $(D @system) is
rejected because it is redundant.)

$(H3 $(LNAME2 safe-interfaces, Safe Interfaces))
$(P Interfaces and safe-interface rules are unavailable.)

$(H3 $(LNAME2 safe-values, Safe Values))
$(P No value acquires D safety guarantees from a function annotation.)

$(H3 $(LNAME2 null-dereferences, Null Dereferences))
$(P Calling through a null function pointer/delegate or dereferencing a null
pointer is invalid. Implicit $(D @system) does not insert a safety proof.)

$(H3 $(LNAME2 safe-aliasing, Safety Aliasing Rules))
$(P D's $(D @safe) aliasing restrictions are not Laser-D guarantees.)

$(H2 $(LNAME2 function-attribute-inference, Function Attribute Inference))

$(P Return type inference with $(D auto) is supported. Safety, purity, GC, and
throwing attributes are not inferred: the Laser-D function invariants are fixed
for every function type.)

$(H2 $(LNAME2 pseudo-member, Uniform Function Call Syntax (UFCS)))

$(P UFCS is supported for an ordinary free function whose first parameter
matches the expression before the dot. The call must use explicit parentheses,
and UFCS does not create property behavior.)

---
int twice(int value)
{
    return value * 2;
}

int result = 3.twice();
---

$(H2 $(LNAME2 conformance, Conformance Boundary))

$(P The established function subset includes ordinary declarations and bodies,
prototypes, value returns and inference, explicit calls, static overloads,
$(D in)/$(D out)/$(D ref) parameters, default arguments, local automatic
variables, function pointers, non-capturing literals and delegates, struct
method delegates, UFCS, function templates, and CTFE. Rejected attributes,
contracts, reference returns, lifetime annotations, lazy parameters, closure
capture, virtual dispatch, property calls, and optional parentheses are outside
the language. Named nested functions are rejected; variadics and
generated/special entry points remain under review.)

$(SPEC_SUBNAV_PREV_NEXT const3, Type Qualifiers, operatoroverloading, Operator Overloading)
)

Macros:
    TITLE=Functions
    CATEGORY_SPEC=$0
