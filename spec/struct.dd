Ddoc

$(SPEC_S Structs and Unions,

$(HEADERNAV_TOC)

$(H2 $(LNAME2 intro, Overview))

$(P Laser-D supports D structs and unions as runtime-free value types. They
provide named inline storage, explicit methods, ordinary construction, and
layout suitable for systems programming without a class hierarchy, garbage
collector, or D runtime.)

$(LASER_NORMATIVE The rules in this chapter apply to native D structs and
unions. ImportC retains C struct and union declarations under the ImportC
specification. Struct declarations under C++ linkage are rejected.)

$(H3 $(LNAME2 structs, Structs))

$(GRAMMAR
$(GNAME StructDeclaration):
    $(D struct) $(GLINK_LEX Identifier) $(D {) $(GLINK2 module, DeclDefs) $(D })
    $(D struct) $(GLINK_LEX Identifier) $(D ;)
)

$(P A struct value contains each non-static instance field. Structs do not
inherit, implement interfaces, or contain a hidden virtual-function table.)

$(SPEC_RUNNABLE_EXAMPLE_COMPILE
---
struct Point
{
    int x;
    int y;

    int sum()
    {
        return x + y;
    }
}
---
)

$(H3 $(LNAME2 storage, Storage))

$(P Struct and union storage may be local, embedded in another supported value,
placed in a fixed array, or obtained explicitly through pointer or C allocation
facilities. The general Laser-D restrictions on mutable static storage apply.)

$(P A pointer to a forward-declared opaque struct or union is supported. A value
of an opaque aggregate cannot be instantiated until its definition is
available.)

$(H3 $(LNAME2 unions, Unions))

$(GRAMMAR
$(GNAME UnionDeclaration):
    $(D union) $(GLINK_LEX Identifier) $(D {) $(GLINK2 module, DeclDefs) $(D })
    $(D union) $(GLINK_LEX Identifier) $(D ;)
)

$(P A union overlays its instance fields at the same address. Its size and
alignment accommodate every field. The language does not track which field is
currently active.)

$(H2 $(LEGACY_LNAME2 struct-members, members, Members))

$(P Struct and union bodies may contain fields, supported methods, ordinary
constructors, nested type declarations, manifest constants, templates, and
other declarations permitted by their individual Laser-D rules.)

$(LASER_REJECTED A member cannot restore a rejected language feature. In
particular, aggregate bodies cannot contain destructors, postblits, invariants,
$(D alias this), mutable static fields, user-defined attributes, rejected
function annotations, or native class/interface declarations.)

$(H3 $(LNAME2 unions_and_special_memb_funct, Union Member Restrictions))

$(P At most one overlapping union field may have a default initializer. A union
may have an ordinary constructor that explicitly initializes the intended
field. Laser-D does not implicitly destroy a previously active field.)

$(H3 $(LNAME2 recursive-types, Recursive Aggregates))

$(P A struct or union cannot contain itself recursively by value because its
size would be infinite. Recursion through a pointer is supported.)

$(SPEC_RUNNABLE_EXAMPLE_COMPILE
---
struct Node
{
    int value;
    Node* next;
}
---
)

$(H2 $(LNAME2 struct_layout, Layout))

$(P Fields are laid out in declaration order subject to target alignment and
padding rules. $(D .sizeof), $(D .alignof), field $(D .offsetof), and
$(D .tupleof) expose the resulting compile-time information.)

$(P Struct layout is not a promise of cross-target binary identity. Portable
code must not assume padding, alignment, or endianness beyond the target ABI.
Interoperability code must verify the layout required by each external ABI.)

$(H2 $(LNAME2 bitfields, Bit Fields))

$(GRAMMAR
$(GNAME BitFieldDeclaration):
    $(GLINK2 type, BasicType) $(GLINK_LEX Identifier) $(D :) $(EXPRESSION) $(D ;)
    $(GLINK2 type, BasicType) $(GLINK_LEX Identifier) $(D :) $(EXPRESSION) $(D =) $(EXPRESSION) $(D ;)
    $(GLINK2 type, BasicType) $(D :) $(D 0 ;)
)

$(P Signed and unsigned integral bit fields are supported in structs and
unions. Their widths are compile-time values no larger than their storage type.
An anonymous zero-width field forces the next field to a new allocation unit;
a named zero-width field is rejected.)

$(P Bit fields support ordinary access, assignment, permitted default
initializers, and the corresponding compile-time traits. Bit-field packing and
ordering are implementation-defined. External layouts must be verified for
every supported target.)

$(H2 $(LNAME2 POD, Plain Value Aggregates))

$(P A struct composed of ordinary value-copyable fields and without special
copy, move, or destruction behavior has direct value semantics. The
$(D __traits(isPOD)) and related supported traits may inspect this property.)

$(H2 $(LNAME2 opaque_struct_unions, Opaque Structs and Unions))

$(P A declaration ending in $(D ;) introduces an opaque aggregate. Only
pointers and declarations that do not require its size are valid before a
matching definition is available.)

$(H2 $(LNAME2 initialization, Initialization))

$(H3 $(LNAME2 default_struct_init, Default Struct Initialization))

$(P Default initialization initializes each field using its permitted field
initializer or the field type's default initialization. Struct $(D .init)
denotes that compile-time default value when all required field initialization
is available.)

$(H3 $(LNAME2 static_struct_init, Static Struct Initialization))

$(P Struct values in permitted immutable static storage require an initializer
that is valid for static initialization. The general rejection of mutable
global and static storage applies independently.)

$(H3 $(LNAME2 default_union_init, Default Union Initialization))

$(P A union's default initialization is determined by its permitted default
field initializer or ordinary D union initialization rules. More than one
overlapping default field initializer is rejected.)

$(H3 $(LNAME2 static_union_init, Static Union Initialization))

$(P A union in permitted immutable static storage must have a statically valid
initial value. No runtime registration or lifecycle function is generated.)

$(H3 $(LNAME2 dynamic_struct_init, Runtime Struct Initialization))

$(P Local struct values may be initialized with field values, a struct literal,
or an ordinary constructor. This performs no implicit allocation.)

$(H3 $(LNAME2 dynamic_union_init, Runtime Union Initialization))

$(P Local union values may be initialized according to the selected field or an
ordinary union constructor. The program is responsible for maintaining any
active-field convention.)

$(H2 $(LEGACY_LNAME2 StructLiteral, struct-literal, Struct Literals))

$(P A struct literal names the struct type and supplies compatible field values
in declaration order. Omitted fields receive their supported default
initialization.)

$(SPEC_RUNNABLE_EXAMPLE_COMPILE
---
struct Point
{
    int x;
    int y;
}

Point origin = Point(0, 0);
---
)

$(H2 $(LNAME2 union-literal, Union Literals))

$(P Union initialization must select a representation permitted by the union's
fields and constructors. It does not attach a hidden runtime tag.)

$(H2 $(LNAME2 anonymous, Anonymous Structs and Unions))

$(P Anonymous unions are supported for directly overlaying fields in a
containing aggregate. Anonymous structs and unions obey the same layout,
initialization, and rejected-member rules as named aggregates.)

$(H2 $(LEGACY_LNAME2 struct_instance_properties, struct_properties, Struct Properties))

$(P Supported compile-time struct properties include $(D .sizeof),
$(D .alignof), $(D .tupleof), $(D .stringof), and other properties classified
by the properties chapter. Properties cannot introduce TypeInfo, allocation,
or another rejected runtime facility.)

$(H3 $(LNAME2 struct_field_properties, Field Properties))

$(P Fields expose supported properties such as $(D .offsetof). Bit fields also
expose the supported bit-field traits and numeric bounds.)

$(H2 $(LEGACY_LNAME2 ConstStruct, const-struct, Immutable Structs))

$(P Transitively $(D immutable) struct and union values are supported. The
rejected $(D const), $(D inout), and $(D shared) qualifiers remain unavailable
for aggregate types, fields, receivers, and methods.)

$(H2 $(LNAME2 UnionConstructor, Union Constructors))

$(P An ordinary union constructor may explicitly initialize one representation.
It obeys every ordinary Laser-D function restriction.)

$(H2 $(LEGACY_LNAME2 Struct-Constructor, struct-constructor, Struct Constructors))

$(P Ordinary struct constructors are supported as a convenience for initializing
small value types. A constructor is named $(D this), returns no source-level
value, and initializes the existing destination storage.)

$(LASER_REJECTED A constructor cannot be declared with a source-level $(D ref)
return annotation. Constructor contracts, attributes rejected by Laser-D,
allocation through $(D new), and lifecycle behavior through a destructor or
postblit are also rejected.)

$(H3 $(LNAME2 delegating-constructor, Constructor Delegation))

$(LASER_REJECTED A struct constructor cannot delegate to another constructor
with $(D this(...)). Constructors initialize their fields directly.)

$(H3 $(LNAME2 struct-instantiation, Struct Instantiation))

$(P A struct is instantiated in existing storage by declaration, literal,
assignment, parameter passing, return, or placement performed through explicit
pointer/C storage management. Every $(D new) expression is rejected.)

$(H3 $(LNAME2 constructor-attributes, Constructor Function Rules))

$(P Constructors inherit Laser-D's implicit function attributes and may not
spell rejected attributes or parameter/return annotations. Templated
constructors are supported when their bodies and inferred instances use only
supported features.)

$(H4 $(LNAME2 pure-constructors, Purity))

$(P Laser-D does not expose D's explicit or inferred $(D pure) function
attribute. Constructors follow the same conservative function model as every
other function.)

$(H3 $(LNAME2 disable_default_construction, Disabled Default Construction))

$(LASER_REJECTED $(D @disable this()) and every other explicit use of
$(D @disable) are rejected. Laser-D structs cannot opt out of ordinary default
initialization through an attribute.)

$(H3 $(LNAME2 field-init, Constructor Field Initialization))

$(P A constructor may assign or initialize its fields explicitly. All fields
must have a valid state before they are read. Union constructors must respect
the program's selected active-field convention.)

$(H2 $(LEGACY_LNAME2 StructCopyConstructor, struct-copy-constructor, Copy Constructors))

$(LASER_REJECTED User-defined struct copy constructors are rejected. Laser-D
supports ordinary field-wise value copying for aggregates whose fields are
value-copyable and which require no postblit or destructor.)

$(H3 $(LNAME2 disable-copy, Disabled Copying))

$(LASER_REJECTED Attribute-driven disabled copying is rejected together with
$(D @disable) and user-defined copy constructors.)

$(H3 $(LNAME2 copy-constructor-attributes, Copy Constructor Attributes))

$(P No copy-constructor-specific attribute surface is currently guaranteed.)

$(H3 $(LNAME2 implicit-copy-constructors, Implicit Copying))

$(P The frontend may generate ordinary field-wise copying required to implement
value semantics. It must not invoke a rejected source postblit.)

$(H2 $(LEGACY_LNAME2 StructMoveConstructor, struct-move-constructor, Move Constructors))

$(LASER_REJECTED User-defined struct move constructors are rejected. Laser-D
provides no general ownership transfer or moved-from-state model.)

$(H3 $(LNAME2 disable-move, Disabled Moving))

$(LASER_REJECTED Attribute-driven disabled moving is rejected together with
$(D @disable) and user-defined move constructors.)

$(H3 $(LNAME2 move-constructor-attributes, Move Constructor Attributes))

$(P No move-constructor-specific attribute surface is currently guaranteed.)

$(H3 $(LNAME2 implicit-move-constructors, Implicit Moving))

$(P Frontend/backend transfer optimizations do not create a source-visible
ownership feature or permit the rejected $(D __rvalue) expression.)

$(H2 $(LEGACY_LNAME2 StructPostblit, struct-postblit, Struct Postblits))

$(LASER_REJECTED A source declaration $(D this(this)) is rejected. Copying a
Laser-D struct does not invoke a user-defined post-copy hook.)

$(H2 $(LNAME2 member-functions, Member Functions))

$(P Struct and union methods are supported ordinary functions with an explicit
call in source. They receive their aggregate context without a class object
model or virtual dispatch. Immutable receiver methods are supported; rejected
qualifiers and function annotations remain unavailable.)

$(H2 $(LEGACY_LNAME2 StructDestructor, struct-destructor, Struct Destructors))

$(LASER_REJECTED A source struct or union destructor $(D ~this()) is rejected.
Laser-D does not schedule hidden user-defined work when an aggregate leaves
scope, is overwritten, or is copied.)

$(H2 $(LNAME2 union-field-destruction, Union Field Destruction))

$(P Laser-D performs no implicit destruction of a union field. Programs needing
resource release use explicit functions or the supported $(D scope(exit))
statement around an explicitly managed resource.)

$(H2 $(LNAME2 Invariant, Struct Invariants))

$(LASER_REJECTED Aggregate $(D invariant) declarations are rejected. Validation
must be expressed as an ordinary explicitly called method or function.)

$(H2 $(LEGACY_LNAME2 AssignOverload, assign-overload, Assignment Overloading))

$(P Modern $(D opAssign) and related operator hooks are supported only as
specified by the operator-overloading chapter. They are ordinary explicit
method calls after frontend lowering and remain subject to all aggregate and
function restrictions. Legacy D1 hooks are rejected.)

$(H2 $(LEGACY_LNAME2 AliasThis, alias-this, Alias This))

$(LASER_REJECTED Both $(D alias member this) and $(D alias this = member) are
rejected. Member lookup and conversions never implicitly forward through an
aggregate field.)

$(H2 $(LNAME2 nested, Nested Structs))

$(P A struct declared inside another aggregate or namespace is supported when
it has ordinary value semantics. A function-local struct containing only
context-free value storage is also supported.)

$(LASER_REJECTED A nested struct that requires a hidden pointer to an enclosing
function or aggregate context is rejected. Outer values must instead be passed
explicitly as fields or function parameters.)

$(H2 $(LNAME2 cpp-structs, C++ Structs))

$(LASER_REJECTED Struct declarations under $(D extern(C++)) linkage are rejected,
including forward declarations, definitions, templates, and explicit C++
class/struct mangling forms. C++ free-function linkage is specified separately
and remains available.)

$(H2 $(LNAME2 conformance, Conformance Boundary))

$(P The guaranteed aggregate subset consists of ordinary value storage, layout,
fields, default and explicit initialization, literals, methods, direct
constructors, named and anonymous unions, and integral bit fields. Destructors,
postblits, invariants, $(D alias this), and C++ structs are rejected. Advanced
copy and move constructors, constructor delegation, $(D @disable), and
hidden-context nested structs are rejected.)

$(SPEC_FOOTER)
)
