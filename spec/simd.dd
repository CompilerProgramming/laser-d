Ddoc

$(SPEC_S Vector Extensions (Excluded),

$(HEADERNAV_TOC)

$(LASER_NORMATIVE D vector types and compiler SIMD intrinsics are not part of
Laser-D source. Their syntax is recognized only far enough to issue a Laser-D
diagnostic.)

$(H2 $(LNAME2 rejected-surface, Rejected Surface))

$(LASER_EXCLUDED Laser-D rejects:)

$(UL
$(LI the $(D __vector) type constructor and every vector type,)
$(LI $(D __simd), $(D __simd_sto), and $(D __simd_ib) intrinsics,)
$(LI vector literals, casts, properties, indexing, and operations because no
vector operand type can be formed.)
)

$(H2 $(LNAME2 predefined-versions, Predefined Versions))

$(P The predefined version identifiers $(D D_SIMD), $(D D_AVX), and
$(D D_AVX2) are never defined for Laser-D source. Their absence is a language
decision and does not report the capabilities of the target CPU.)

$(H2 $(LNAME2 arrays, Fixed Arrays Are Not Vectors))

$(P Fixed-size arrays remain supported as inline value storage. They do not
acquire SIMD arithmetic, vector ABI, special alignment, or target-instruction
semantics. Element operations must be written explicitly or provided by
supported struct methods and operators.)

$(H2 $(LNAME2 rationale, Rationale))

$(P D vector types expose target-dependent element sets, widths, alignment,
calling conventions, instruction availability, and compiler intrinsics.
Portable behavior can depend on CPU features and backend lowering choices that
are outside Laser-D's reduced language contract.)

$(H2 $(LNAME2 alternatives, External Vector Implementation))

$(P Optimized vector code may live behind an explicit C-compatible function
boundary, with separate implementations selected by the external build or
library. Laser-D sees only the declared scalar, pointer, or fixed-storage ABI.)

$(P ImportC vector extensions remain a separate part of the ImportC audit.
Their presence in C input does not enable vector syntax in Laser-D source.)

$(SPEC_SUBNAV_PREV_NEXT abi, Application Binary Interface, betterc, Better C)
)

Macros:
CHAPTER=40
TITLE=Vector Extensions (Excluded)
