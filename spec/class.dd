Ddoc

$(SPEC_S Classes (Excluded),

$(HEADERNAV_TOC)

$(LASER_NORMATIVE Classes are not part of Laser-D. The frontend recognizes
class syntax only to issue a Laser-D diagnostic; no class declaration creates
a type or enters semantic analysis of the D object model.)

$(H2 $(LNAME2 rejected-declarations, Rejected Class Declarations))

$(LASER_EXCLUDED The rejection applies to every class declaration in Laser-D
source, including:)

$(UL
$(LI forward declarations and definitions,)
$(LI plain and explicit $(D extern(D)) classes,)
$(LI templated and nested classes,)
$(LI anonymous class expressions,)
$(LI COM classes and the magic $(D IUnknown) object-model root,)
$(LI classes declared with $(D extern(Objective-C)) linkage,)
$(LI classes declared with $(D extern(C++)) linkage, including
$(D extern(C++, class)) and $(D extern(C++, struct)) mangling forms.)
)

$(P Rejecting a declaration before its body is analyzed does not make any
members, aliases, templates, or nested declarations inside that class
available to Laser-D source.)

$(H2 $(LNAME2 unavailable-model, Unavailable Object Model))

$(LASER_EXCLUDED Because class types do not exist, Laser-D has no:)

$(UL
$(LI root $(D Object) class or class references,)
$(LI inheritance, base classes, overriding, or virtual dispatch,)
$(LI class virtual tables, interface tables, or monitor fields,)
$(LI class constructors, destructors, finalizers, or allocators,)
$(LI $(D ClassInfo), class $(D TypeInfo), or runtime class metadata,)
$(LI dynamic class casts or class identity comparisons,)
$(LI $(D super), $(D synchronized) object monitors, or class invariants,)
$(LI class-specific properties such as $(D .classinfo),)
$(LI class-only attributes such as $(D abstract), $(D override), or
class-member $(D final).)
)

$(P These facilities are unavailable rather than merely restricted to
BetterC-compatible cases. Their semantics depend on an object model, runtime
metadata, allocation conventions, or ABI rules that Laser-D deliberately does
not provide.)

$(H2 $(LNAME2 allocation, Allocation))

$(P Every $(D new) expression is rejected independently of the class decision.
Laser-D therefore has neither implicit class allocation nor placement
construction. Explicit foreign allocation functions may return opaque handles,
but those handles are pointers governed by the foreign API, not Laser-D class
references.)

$(H2 $(LNAME2 value-types, Struct Alternatives))

$(P Supported structs and unions provide named value types with inline storage,
fields, methods, direct field-initializing constructors, and modern operator
overloading. They have no inheritance, hidden virtual table, runtime type
identity, implicit allocation, destructor, or finalizer.)

$(P Composition and explicit function calls should be used where a program
would otherwise use inheritance or virtual methods. Function pointers and
non-capturing delegates may provide explicit dispatch when required.)

$(H2 $(LNAME2 foreign-objects, Foreign Object Handles))

$(P A C or other supported foreign interface may expose an object as an opaque
pointer and a set of explicitly declared functions. Laser-D does not infer
ownership, method dispatch, layout, or destruction rules for such a handle.)

$(D_CODE
struct ForeignHandle;

extern(C):
ForeignHandle* foreign_create();
void foreign_operate(ForeignHandle* handle);
void foreign_destroy(ForeignHandle* handle);
)

$(P The foreign API defines whether a handle may be null, how long it remains
valid, whether operations are thread-safe, and which function releases it.
This C-style interface does not enable D, COM, Objective-C, or C++ classes in
Laser-D source.)

$(H2 $(LNAME2 importc, ImportC))

$(P ImportC input retains its separately reviewed C type and declaration
rules. A C structure parsed from ImportC is not a Laser-D class and does not
introduce inheritance or virtual dispatch.)

$(SPEC_SUBNAV_PREV_NEXT struct, Structs and Unions, interface, Interfaces)
)

Macros:
CHAPTER=16
TITLE=Classes (Excluded)
_=
