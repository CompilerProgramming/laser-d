Ddoc

$(SPEC_S Traits,

$(HEADERNAV_TOC)

$(LASER_NORMATIVE $(D __traits) provides compile-time inspection of supported
Laser-D types, declarations, functions, parameters, symbols, layout, and target
information. Trait evaluation does not execute runtime reflection, allocate
storage, or require $(D TypeInfo).)

$(P A predicate may ask whether an operand belongs to a rejected language
category. Such a query does not make that category available: it normally
returns false for valid Laser-D operands, and a trait requiring an actual
excluded operand has no valid Laser-D use.)

$(H2 $(LNAME2 grammar, Grammar))

$(GRAMMAR
$(GNAME TraitsExpression):
    $(D __traits $(LPAREN)) $(GLINK TraitsKeyword) $(D ,) $(GLINK TraitsArguments) $(D $(RPAREN))

$(GNAME TraitsArguments):
    $(GLINK TraitsArgument)
    $(GLINK TraitsArgument) $(D ,) $(GSELF TraitsArguments)

$(GNAME TraitsArgument):
    $(GLINK2 expression, AssignExpression)
    $(GLINK2 type, Type)
)

$(P The accepted number and kind of arguments depend on the selected trait.
Trait names are compiler-defined identifiers, not ordinary functions or
templates.)

$(H2 $(LNAME2 types, Type and Layout Traits))

$(H3 $(LNAME2 type-predicates, Type Predicates))

$(TABLE2 Type Predicates,
$(THEAD Trait, Result)
$(TROW $(D __traits(isArithmetic, operands)), true when every operand has a
supported arithmetic type)
$(TROW $(D __traits(isFloating, operands)), true for supported floating-point
types)
$(TROW $(D __traits(isIntegral, operands)), true for supported integral and
integral-based enum types)
$(TROW $(D __traits(isScalar, operands)), true for supported scalar types,
including pointers)
$(TROW $(D __traits(isUnsigned, operands)), true for supported unsigned
integral and unsigned-based enum types)
$(TROW $(D __traits(isStaticArray, operands)), true for fixed-size array types)
$(TROW $(D __traits(isAssociativeArray, operands)), reports whether an operand
is an associative-array type)
$(TROW $(D __traits(isOverlapped, field)), true when a field overlaps other
aggregate storage)
)

$(P Associative-array types are rejected, so
$(D __traits(isAssociativeArray, ...)) remains useful to generic code but
cannot receive a valid Laser-D associative-array operand. Similar predicates
never authorize rejected scalar, vector, class, or interface types.)

$(H3 $(LNAME2 representation-predicates, Representation Predicates))

$(TABLE2 Representation Predicates,
$(THEAD Trait, Result)
$(TROW $(D __traits(isCopyable, T)), whether values of $(D T) have ordinary
copy semantics)
$(TROW $(D __traits(isPOD, T)), whether $(D T) is plain data under the
frontend's representation rules)
$(TROW $(D __traits(isZeroInit, T)), whether all-zero storage is $(D T)'s
default initializer)
$(TROW $(D __traits(hasCopyConstructor, T)), whether $(D T) declares a copy
constructor)
$(TROW $(D __traits(hasMoveConstructor, T)), whether $(D T) declares a move
constructor)
$(TROW $(D __traits(hasPostblit, T)), whether $(D T) declares a postblit)
$(TROW $(D __traits(needsDestruction, T)), whether $(D T) requires destruction)
$(TROW $(D __traits(getAliasThis, T)), aliases introduced by $(D alias this))
)

$(P Copy constructors, move constructors, postblits, destructors, and
$(D alias this) are rejected. Their predicates remain available for generic
code and report their absence on conforming Laser-D aggregate types.)

$(H3 $(LNAME2 bitfield-traits, Bit-Field Traits))

$(TABLE2 Bit-Field Traits,
$(THEAD Trait, Result)
$(TROW $(D __traits(isBitfield, field)), whether the symbol is a bit field)
$(TROW $(D __traits(getBitfieldOffset, field)), bit offset within its storage
unit)
$(TROW $(D __traits(getBitfieldWidth, field)), declared width in bits)
)

$(P These traits inspect the target layout chosen for a supported bit field.
They do not change its width or storage.)

$(H3 $(LNAME2 initSymbol, Initialization Symbol))

$(P $(D __traits(initSymbol, T)) returns the compiler-generated initialization
symbol for a supported aggregate type when such a symbol exists. It exposes no
GC pointer map or runtime type metadata.)

$(H3 $(LNAME2 class-only, Class-Only Queries))

$(P The frontend recognizes $(D isAbstractClass), $(D isFinalClass),
$(D isCOMClass), $(D classInstanceSize), $(D classInstanceAlignment),
$(D getVirtualFunctions), and $(D getVirtualMethods). Class declarations and
class types are rejected, so the size, alignment, and virtual-member queries
have no valid class operand in Laser-D. The predicate forms return false for
ordinary supported non-class operands.)

$(H2 $(LNAME2 functions, Function Traits))

$(TABLE2 Function Traits,
$(THEAD Trait, Result)
$(TROW $(D __traits(isStaticFunction, symbol)), whether a function requires no
receiver)
$(TROW $(D __traits(isAbstractFunction, symbol)), whether a function is
abstract)
$(TROW $(D __traits(isVirtualFunction, symbol)), whether a function is virtual)
$(TROW $(D __traits(isVirtualMethod, symbol)), whether a member is a virtual
method)
$(TROW $(D __traits(isFinalFunction, symbol)), whether a function is final)
$(TROW $(D __traits(isOverrideFunction, symbol)), whether a function overrides
another)
$(TROW $(D __traits(getVirtualIndex, symbol)), virtual-table index or a
negative value when none exists)
$(TROW $(D __traits(isReturnOnStack, symbol)), target-ABI decision for returning
the function result indirectly)
$(TROW $(D __traits(getFunctionAttributes, symbol)), compile-time sequence of
the function's effective attributes)
$(TROW $(D __traits(getFunctionVariadicStyle, symbol)), variadic style name)
)

$(P Native Laser-D functions are non-virtual because classes and interfaces
are unavailable. The virtual and override predicates remain usable by generic
code but return false for valid ordinary functions and struct methods.)

$(P $(D getFunctionAttributes) includes effective implicit attributes such as
$(D nothrow) and $(D @nogc). Their presence in the returned sequence does not
permit those rejected explicit annotations in source.)

$(P $(D getFunctionVariadicStyle) reports $(D "none") for ordinary functions
and $(D "stdarg") for supported C ABI variadics. Rejected D and typesafe
runtime-variadic declarations cannot be introduced merely to query them.)

$(H2 $(LNAME2 function-parameters, Variable and Parameter Traits))

$(TABLE2 Variable and Parameter Traits,
$(THEAD Trait, Result)
$(TROW $(D __traits(isRef, symbol)), whether the variable or parameter is
declared $(D ref))
$(TROW $(D __traits(isOut, symbol)), whether the parameter is declared
$(D out))
$(TROW $(D __traits(isLazy, symbol)), whether the parameter is declared
$(D lazy))
$(TROW $(D __traits(getParameterStorageClasses, function, index)),
compile-time sequence of storage-class names for the indexed parameter)
$(TROW $(D __traits(parameters)), alias sequence of the current function's
parameters)
)

$(P $(D in), $(D out), and $(D ref) are the supported explicit parameter
annotations. $(D lazy), $(D scope), $(D return), $(D inout), and other rejected
annotations cannot be restored through inspection; their predicates or storage
class names are useful only when generic code examines a declaration that can
otherwise exist.)

$(P $(D __traits(parameters)) is valid in a function context and provides its
parameters in declaration order. It creates no runtime tuple.)

$(H2 $(LNAME2 symbols, Symbol Traits))

$(H3 $(LNAME2 identity-and-kind, Names, Identity, and Kind))

$(TABLE2 Name and Kind Traits,
$(THEAD Trait, Result)
$(TROW $(D __traits(identifier, symbol)), unqualified identifier)
$(TROW $(D __traits(fullyQualifiedName, symbol)), fully qualified compile-time
name)
$(TROW $(D __traits(isTemplate, symbol)), whether the symbol is a template
declaration)
$(TROW $(D __traits(isModule, symbol)), whether the symbol is a module)
$(TROW $(D __traits(isPackage, symbol)), whether the symbol is a package)
$(TROW $(D __traits(isNested, symbol)), whether the declaration has lexical
nesting)
$(TROW $(D __traits(isFuture, symbol)), whether the declaration carries D's
future status)
$(TROW $(D __traits(isDeprecated, symbol)), whether the declaration is
deprecated)
$(TROW $(D __traits(isDisabled, symbol)), whether the declaration is disabled)
$(TROW $(D __traits(isSame, left, right)), whether both arguments denote the
same type, symbol, or compile-time entity)
)

$(P A kind predicate may report false for a supported operand when the queried
kind is excluded or unavailable. Inspection does not authorize declarations
whose attributes or forms are rejected elsewhere.)

$(H3 $(LNAME2 members, Members and Relationships))

$(TABLE2 Member Traits,
$(THEAD Trait, Result)
$(TROW $(D __traits(hasMember, aggregate, name)), whether the named member
exists)
$(TROW $(D __traits(getMember, aggregate, name)), the named member symbol or
expression)
$(TROW $(D __traits(getOverloads, aggregate, name)), overload sequence for the
name)
$(TROW $(D __traits(allMembers, aggregate)), compile-time sequence of all
member names)
$(TROW $(D __traits(derivedMembers, aggregate)), compile-time sequence of
members introduced by the declaration)
$(TROW $(D __traits(parent, symbol)), lexical parent)
$(TROW $(D __traits(child, parent, symbol)), the child symbol rebound through
the supplied parent value or scope)
)

$(P Member sequences and overload sets are compile-time entities. Calling a
returned function or accessing a returned field must still use valid explicit
Laser-D syntax and satisfy receiver rules.)

$(H3 $(LNAME2 declaration-metadata, Declaration Metadata))

$(TABLE2 Declaration Metadata Traits,
$(THEAD Trait, Result)
$(TROW $(D __traits(getAttributes, symbol)), user-defined attribute sequence)
$(TROW $(D __traits(getLinkage, symbol)), linkage name)
$(TROW $(D __traits(getLocation, symbol)), source filename, line, and column)
$(TROW $(D __traits(getCppNamespaces, symbol)), C++ namespace sequence)
$(TROW $(D __traits(getVisibility, symbol)), visibility name)
$(TROW $(D __traits(getProtection, symbol)), protection name)
$(TROW $(D __traits(getTargetInfo, key)), compiler target information selected
by the key)
)

$(P Laser-D source declarations cannot carry user-defined attributes, so
$(D getAttributes) returns an empty sequence for them. C implementation
attributes in ImportC input remain governed by the ImportC rules.)

$(P Linkage, visibility, protection, C++ namespaces, and target information
report frontend or target facts. A returned value does not expand the set of
source features or create a cross-platform guarantee beyond the applicable
Laser-D ABI and interoperability specifications.)

$(H2 $(LNAME2 semantic-probes, Semantic Probes))

$(H3 $(LNAME2 compiles, $(D __traits(compiles))))

$(P $(D __traits(compiles, arguments)) semantically checks its arguments in a
gagged compile-time context. It returns true only if all arguments are valid
Laser-D; otherwise it returns false without making the rejected construct part
of the program.)

$(D_CODE
struct Record
{
    int value;
}

static assert(__traits(compiles, Record.init.value));
static assert(!__traits(compiles, Record.init.missing));
)

$(P This trait supports feature detection in templates. It does not suppress a
diagnostic when the same rejected construct is instantiated or used outside
the probe.)

$(H3 $(LNAME2 isSame, $(D __traits(isSame))))

$(P $(D __traits(isSame, left, right)) tests compile-time identity rather than
runtime equality. It is supported for valid types, symbols, aliases, and other
accepted operands.)

$(H2 $(LNAME2 excluded, Excluded Traits))

$(H3 $(LNAME2 toType, $(D __traits(toType)) (Excluded)))

$(LASER_EXCLUDED $(D __traits(toType)) is rejected because it constructs a
type from textual or mangled input. It would reintroduce a string-to-language
generation boundary analogous to rejected string mixins.)

$(H3 $(LNAME2 getPointerBitmap, $(D __traits(getPointerBitmap)) (Excluded)))

$(LASER_EXCLUDED $(D __traits(getPointerBitmap)) is rejected because Laser-D
has no garbage collector or GC scanning-metadata contract.)

$(H3 $(LNAME2 getUnitTests, $(D __traits(getUnitTests)) (Excluded)))

$(LASER_EXCLUDED $(D __traits(getUnitTests)) is rejected because Laser-D has
no language $(D unittest) declarations or hidden test-function discovery
protocol.)

$(H2 $(LNAME2 restrictions, Reflection Boundary))

$(P Traits inspect compiler-known information; they do not provide runtime
reflection. A trait cannot allocate, read a file, discover runtime classes,
invoke a hidden lifecycle function, or bypass a parser or semantic diagnostic.)

$(P Results may be used by supported templates, constraints, $(D static if),
$(D static foreach), $(D static assert), and CTFE. Any declaration selected or
generated through that compile-time control flow remains subject to all
Laser-D restrictions.)

$(SPEC_SUBNAV_PREV_NEXT version, Conditional Compilation, errors, Error Handling)
)

Macros:
CHAPTER=26
TITLE=Traits
