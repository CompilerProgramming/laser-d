Ddoc

$(SPEC_S Operator Overloading,

$(HEADERNAV_TOC)

$(LASER_NORMATIVE Laser-D supports modern operator overloading on structs.
An overloaded operator is rewritten to an explicitly declared struct method or
method template. The rewrite does not add allocation, ownership, runtime type
metadata, virtual dispatch, or a hidden object model.)

$(P Operator syntax is intended for value types whose operations have a clear
conventional meaning, such as numeric, matrix, fixed-storage, or iterator
types. The compiler enforces the hook signatures and the general Laser-D
language restrictions; it does not judge whether an overload is intuitive.)

$(H2 $(LNAME2 common-rules, Common Rules))

$(UL
$(LI Only supported struct types participate. Classes and interfaces are
unavailable.)
$(LI A hook is an ordinary or templated method and must obey all Laser-D type,
parameter, result, attribute, purity, and storage rules.)
$(LI Hook calls use normal overload resolution and template constraint
evaluation.)
$(LI Explicit function-call parentheses remain mandatory when a hook or other
method is called directly.)
$(LI Built-in behavior is used when no aggregate operand requires an operator
rewrite.)
$(LI Operator overloading does not change precedence, associativity, or
operand evaluation order.)
)

$(H2 $(LEGACY_LNAME2 Unary, unary, Unary Operators))

$(P A supported unary operator on a struct value $(I value) is rewritten to
$(D value.opUnary!"operator"()).)

$(TABLE2 Unary Operator Rewrites,
$(THEAD Source, Rewrite)
$(TROW $(D -value), $(D value.opUnary!"-"()))
$(TROW $(D +value), $(D value.opUnary!"+"()))
$(TROW $(D ~value), $(D value.opUnary!"~"()))
$(TROW $(D *value), $(D value.opUnary!"*"()))
$(TROW $(D ++value), $(D value.opUnary!"++"()))
$(TROW $(D --value), $(D value.opUnary!"--"()))
)

$(P The operator token is an immutable compile-time string template argument.
A hook may specialize or constrain that argument.)

$(H3 $(LNAME2 postfix, Postfix Increment and Decrement))

$(P Postfix $(D value++) and $(D value--) preserve the value before applying
the corresponding prefix hook. The struct must therefore be ordinarily
copyable under the Laser-D struct rules. No postblit, copy constructor, move
constructor, or destructor is invoked.)

$(H2 $(LEGACY_LNAME2 Binary, binary, Binary Operators))

$(P For a binary expression $(D left op right), overload resolution first
considers $(D left.opBinary!"op"(right)). If that is not viable and the right
operand is a struct, it considers
$(D right.opBinaryRight!"op"(left)).)

$(P Modern binary hooks may represent arithmetic, bitwise, shift,
concatenation-token, exponentiation, or membership-token operations when their
parameter and result types are otherwise supported. A hook using $(D "~") does
not enable built-in GC-backed array concatenation.)

$(H2 $(LNAME2 eqcmp, Equality and Ordering))

$(H3 $(LNAME2 equals, Equality))

$(P $(D left == right) and $(D left != right) use a viable
$(D opEquals) method. If no custom equality hook is present, supported structs
use field-wise equality. An equality hook returns $(D bool).)

$(H3 $(LNAME2 compare, Ordering))

$(P $(D opCmp) returns a negative value, zero, or a positive value. Relational
operators compare that result with zero:)

$(TABLE2 Ordering Rewrites,
$(THEAD Source, Meaning)
$(TROW $(D left < right), $(D left.opCmp(right) < 0))
$(TROW $(D left <= right), $(D left.opCmp(right) <= 0))
$(TROW $(D left > right), $(D left.opCmp(right) > 0))
$(TROW $(D left >= right), $(D left.opCmp(right) >= 0))
)

$(P Reverse dispatch may be selected by ordinary overload resolution when the
left-hand call is not viable. Programs should keep $(D opEquals) and
$(D opCmp) logically consistent; the compiler does not prove that relationship.)

$(H2 $(LEGACY_LNAME2 Cast, cast, Cast Operators))

$(P An explicit $(D cast(Target) value) may call
$(D value.opCast!Target()). The target and result must be supported Laser-D
types. Boolean conversion through $(D opCast!bool) may be used where a Boolean
condition is required.)

$(P A cast hook cannot introduce a rejected class, associative-array, vector,
$(D real), imaginary, complex, qualified, or other excluded type.)

$(H2 $(LEGACY_LNAME2 FunctionCall, function-call, Call Operators))

$(P $(D value(arguments)) calls $(D value.opCall(arguments)). The source call
must contain parentheses, including when there are no arguments.)

$(P Call operators do not make optional-parentheses property syntax available.
They are ordinary explicit calls after the operator rewrite.)

$(H2 $(LEGACY_LNAME2 Assignment, assignment, Assignment))

$(P Assignment to an existing struct may call
$(D destination.opAssign(source)) when the hook is viable. Initialization of a
new variable remains initialization and does not call $(D opAssign).)

$(H2 $(LEGACY_LNAME2 OpAssign, op-assign, Compound Assignment))

$(P $(D destination op= source) may call
$(D destination.opOpAssign!"op"(source)). The hook performs the mutation; it
must not rely on a reference return.)

$(H2 $(LEGACY_LNAME2 ArrayOps, array-ops, Indexing and Slicing))

$(H3 $(LEGACY_LNAME2 Array, array, Index Reads))

$(P $(D value[indices]) calls $(D value.opIndex(indices)). Laser-D requires
$(D opIndex) to return by value. Returning a slice is permitted only as a
non-owning view whose backing storage remains valid.)

$(H3 $(LNAME2 index-assignment, Index Assignment))

$(TABLE2 Index Mutation Rewrites,
$(THEAD Source, Rewrite)
$(TROW $(D value[indices] = replacement),
       $(D value.opIndexAssign(replacement, indices)))
$(TROW $(D value[indices] op= operand),
       $(D value.opIndexOpAssign!"op"(operand, indices)))
$(TROW $(D ++value[indices]),
       $(D value.opIndexUnary!"++"(indices)))
$(TROW $(D -value[indices]),
       $(D value.opIndexUnary!"-"(indices)))
)

$(P Index mutation uses these dedicated hooks instead of assigning through a
reference returned by $(D opIndex). This preserves Laser-D's rejection of
reference return values.)

$(H3 $(LEGACY_LNAME2 Slice, slice, Slicing))

$(P A one-dimensional slice $(D value[lower .. upper]) may call
$(D value.opSlice(lower, upper)) to construct a slice descriptor, followed by
the applicable read or mutation hook. A full slice may use the corresponding
parameterless form.)

$(P The directly supported one-dimensional slice-assignment hook is
$(D value.opSliceAssign(replacement, lower, upper)). Any slice returned to the
program remains subject to the ordinary non-owning slice rules.)

$(H3 $(LNAME2 dollar, Dollar))

$(P Within an overloaded index or slice expression, $(D $) calls
$(D value.opDollar()). Its result is used only as an ordinary value in the
surrounding index expression.)

$(H2 $(LNAME2 multidimensional, Multidimensional Indexing))

$(LASER_NORMATIVE Modern multidimensional indexing and slicing are supported.
Each sliced dimension lowers independently before the final read or mutation
hook is called.)

$(UL
$(LI $(D opDollar!dimension()) supplies $(D $) for a dimension.)
$(LI $(D opSlice!dimension(lower, upper)) constructs that dimension's slice
descriptor.)
$(LI $(D opIndex) receives the resulting mixture of scalar indices and slice
descriptors.)
$(LI $(D opIndexAssign), $(D opIndexOpAssign), and $(D opIndexUnary) provide
the corresponding mutations and unary operations.)
)

$(P The container expression is evaluated once. Dimension numbers are
compile-time values. These rewrites do not create multidimensional
GC-managed arrays; storage and descriptors must use supported Laser-D types.)

$(H2 $(LNAME2 opdispatch, $(D opDispatch)))

$(P A struct may use the templated $(D opDispatch) hook to handle an otherwise
unresolved member name. The name is supplied as an immutable compile-time
string, and the selected hook is called with explicit parentheses.)

$(P $(D opDispatch) cannot restore property calls without parentheses, string
mixins, runtime reflection, or members whose declarations use rejected
features.)

$(H2 $(LNAME2 immutable-receivers, Immutable Receivers))

$(P Operator hooks may be declared for an $(D immutable) receiver and invoked
on immutable struct values. Parameters may use supported $(D const) or
$(D immutable) types. Postfix $(D const) receiver qualifiers and all $(D inout)
qualifiers remain unavailable.)

$(H2 $(LNAME2 restrictions, Cross-Cutting Restrictions))

$(LASER_EXCLUDED Operator hooks cannot use or implicitly restore:)

$(UL
$(LI classes, interfaces, inheritance, or virtual dispatch,)
$(LI reference return values,)
$(LI postfix $(D const), $(D inout), $(D shared), or rejected function annotations,)
$(LI postblits, copy or move constructors, destructors, or hidden contexts,)
$(LI GC-backed allocation, array growth, associative arrays, or capturing
delegates,)
$(LI optional call parentheses or $(D @property).)
)

$(H2 $(LEGACY_LNAME2 Old-Style, old-style, Legacy D1 Hooks (Excluded)))

$(LASER_EXCLUDED Legacy D1 operator hook names are rejected on aggregate
instance methods. This includes the old unary, binary, reverse-binary,
membership, concatenation, dereference, postfix, and compound-assignment hook
families such as $(D opNeg), $(D opAdd), $(D opAdd_r), $(D opIn_r),
$(D opCat), $(D opStar), $(D opPostInc), and $(D opAddAssign).)

$(P Use the modern $(D opUnary), $(D opBinary), $(D opBinaryRight), and
$(D opOpAssign) templates and the modern indexing hooks described above.)

$(SPEC_SUBNAV_PREV_NEXT function, Functions, template, Templates)
)

Macros:
CHAPTER=21
TITLE=Operator Overloading
