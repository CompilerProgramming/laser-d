Ddoc

$(SPEC_S Enums,

$(HEADERNAV_TOC)

$(P Laser-D supports named, anonymous, based, and opaque enums together with
single-member manifest constants. Enum declarations create compile-time values
and, for named enums, lightweight value types. They require no D runtime or
TypeInfo.)

$(GRAMMAR
$(GNAME EnumDeclaration):
    $(D enum) $(GLINK_LEX Identifier) $(GLINK EnumBody)
    $(D enum) $(GLINK_LEX Identifier) $(D :) $(GLINK EnumBaseType) $(GLINK EnumBody)
    $(GLINK AnonymousEnumDeclaration)

$(GNAME EnumBaseType):
    $(GLINK2 type, Type)

$(GNAME EnumBody):
    $(D {) $(GLINK EnumMembers) $(D })
    $(D ;)

$(GNAME EnumMembers):
    $(GLINK EnumMember)
    $(GLINK EnumMember) $(D ,)
    $(GLINK EnumMember) $(D ,) $(GSELF EnumMembers)

$(GNAME EnumMember):
    $(GLINK_LEX Identifier)
    $(GLINK_LEX Identifier) $(D =) $(ASSIGNEXPRESSION)

$(GNAME AnonymousEnumDeclaration):
    $(D enum) $(D :) $(GLINK EnumBaseType) $(D {) $(GLINK EnumMembers) $(D })
    $(D enum) $(D {) $(GLINK AnonymousEnumMembers) $(D })

$(GNAME AnonymousEnumMembers):
    $(GLINK AnonymousEnumMember)
    $(GLINK AnonymousEnumMember) $(D ,)
    $(GLINK AnonymousEnumMember) $(D ,) $(GSELF AnonymousEnumMembers)

$(GNAME AnonymousEnumMember):
    $(GLINK EnumMember)
    $(GLINK2 type, Type) $(GLINK_LEX Identifier) $(D =) $(ASSIGNEXPRESSION)
)

$(LASER_REJECTED Enum members cannot carry user-defined attributes or
$(D @disable). Other built-in declaration attributes are available only when
their individual Laser-D specifications permit them.)

$(H2 $(LNAME2 named_enums, Named Enums))

$(P A named enum introduces a distinct value type. Its members are declared in
the enum's scope and have the named enum type.)

---
enum Direction : ubyte
{
    north,
    east,
    south,
    west,
}
---

$(P A named enum base may be a retained primitive scalar type or another named
enum. If no base is written, the base is inferred from the first explicit
member value when possible and otherwise defaults to $(D int). A rejected type
cannot be introduced as an enum base.)

$(P An enum value implicitly converts to its base type where the ordinary
conversion rules allow. A base-type value does not implicitly convert to the
named enum; an explicit cast or an enum member is required.)

$(LEGACY_LNAME2 enum_default_initializer, enum_variables)

$(P A defined named enum default-initializes to the value of its first member,
not necessarily to numeric zero.)

$(SPEC_RUNNABLE_EXAMPLE_COMPILE
---
enum Status : int
{
    ready = 4,
    running = 7,
}

Status value;
static assert(Status.init == Status.ready);
---
)

$(H3 $(LNAME2 member_values, Enum Member Values))

$(P A member with an initializer uses its compile-time value after conversion
to the enum base. The initializer is subject to all ordinary Laser-D and CTFE
restrictions.)

$(P For an enum whose base is not another enum, the first uninitialized member
has the base type's zero/default value. Each later uninitialized member is the
previous member plus one. The compiler rejects overflow, a base without a
compile-time $(D + 1) operation, or an increment that does not change the
value.)

$(SPEC_RUNNABLE_EXAMPLE_COMPILE
---
enum Code : ushort
{
    first,
    second,
    explicitValue = 10,
    following,
}

static assert(Code.first == 0);
static assert(Code.second == 1);
static assert(Code.following == 11);
---
)

$(P All members are visible to member initializer expressions, subject to
normal forward-reference and circular-dependency diagnostics.)

$(H4 $(LNAME2 enum-based-values, Enum-Based Values))

$(LASER_NORMATIVE When the base type is another enum, the first member may use
the base enum's default value or an explicit value. Every member after the
first must have an explicit initializer. Laser-D does not implicitly apply
arithmetic to produce the next value of another enum type.)

---
enum Base : int { zero, one }

enum Derived : Base
{
    first = Base.zero,
    second = Base.one,
}
---

$(H4 $(LNAME2 opaque-enums, Opaque Enums))

$(P A named declaration with a base type and no body introduces an opaque enum.)

---
enum NativeHandle : uint;
---

$(LASER_NORMATIVE An opaque enum has a known size and alignment but no known
members and no default initializer. It may be used in declarations that supply
an explicit value, in function signatures, and for interoperability. A
default-initialized variable of opaque enum type is rejected.)

$(H3 $(LNAME2 enum_properties, Enum Properties))

$(TABLE2 Named enum properties,
    $(THEAD Property, Meaning)
    $(TROW $(D .init), Value of the first declared member)
    $(TROW $(D .min), Smallest declared member value)
    $(TROW $(D .max), Largest declared member value)
    $(TROW $(D .sizeof), Storage size of an enum value)
)

$(P Computing $(D .min) and $(D .max) requires member values that the compiler
can compare at compile time. Opaque enums have $(D .sizeof) through their base
type but no member-dependent $(D .init), $(D .min), or $(D .max). Generic
compiler properties such as $(D .stringof) remain governed by the properties
chapter.)

$(H3 $(LNAME2 enum_copying_and_assignment, Copying and Assignment))

$(P Enum values have ordinary value-copy and assignment semantics. They never
invoke a struct copy constructor, move constructor, postblit, destructor, or
assignment hook. Those aggregate lifecycle facilities are independently
rejected or restricted by the struct and operator chapters.)

$(H2 $(LNAME2 anonymous_enums, Anonymous Enums))

$(P An enum declaration without a name introduces its members directly into the
surrounding scope and does not create a new enum type.)

---
enum
{
    bufferSize = 256,
    retryCount = 3,
}
---

$(P With an explicit base, every member has that base type. Without a base, a
member's type is its explicitly written type, the type of its initializer, the
previous member's type, or $(D int), in that order where applicable. Every such
type must itself be supported by Laser-D.)

$(P Uninitialized anonymous members use the same initial-value and checked
increment rules as named enums whose base is not another enum.)

$(H3 $(LNAME2 single_member, Single-Member Syntax))

$(P A single anonymous member may omit braces. This form declares a manifest
constant.)

---
enum pageSize = 4096;
enum ulong elementSize = int.sizeof;
---

$(H2 $(LNAME2 manifest_constants, Manifest Constants))

$(P A manifest constant exists only at compile time. It has no runtime storage,
is not an lvalue, and its address cannot be taken. Its initializer is evaluated
by CTFE and must use only supported Laser-D constructs.)

$(SPEC_RUNNABLE_EXAMPLE_COMPILE
---
enum rows = 3;
enum columns = 4;
alias Matrix = int[columns][rows];

static assert(Matrix.sizeof == rows * columns * int.sizeof);
---
)

$(P Manifest constants may be declared at module, aggregate, function, template,
or other scopes where an ordinary declaration is permitted. They do not violate
the rejection of mutable static storage because they have no runtime location.)

$(H2 $(LNAME2 conversions, Enum Conversions and Operations))

$(P Enum casts, comparisons, arithmetic, bitwise operations, and switch behavior
follow the type, expression, and statement chapters. Operations cannot produce
a rejected type or invoke unavailable runtime support. A $(D final switch) over
a defined named enum provides compile-time exhaustiveness checking over its
declared members.)

$(H2 $(LNAME2 conformance, Conformance Boundary))

$(P Laser-D enum conformance includes named and anonymous enums, retained scalar
and enum bases, explicit and checked implicit member values, ordinary enum
properties, opaque enum types, manifest constants, value copying, and switch
use. Attribute-bearing members, rejected base types, default initialization of
opaque enums, and implicit continuation of enum-based member values are outside
the language.)

$(SPEC_SUBNAV_PREV_NEXT interface, Interfaces, const3, Type Qualifiers)
)

Macros:
    CHAPTER=18
    TITLE=Enums
    CATEGORY_SPEC=$0
