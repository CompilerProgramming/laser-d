Ddoc

$(SPEC_S Attributes,

$(HEADERNAV_TOC)

$(P Attributes and declaration modifiers alter linkage, visibility, storage,
or function semantics. Laser-D supports only attributes classified by this
chapter or another normative chapter. Lexical recognition of another D
attribute does not make it available.)

$(H2 $(LNAME2 grammar, Settled Grammar))

$(GRAMMAR
$(GNAME AttributeSpecifier):
    $(GLINK Attribute) $(D :)
    $(GLINK Attribute) $(GLINK DeclarationBlock)

$(GNAME Attribute):
    $(GLINK LinkageAttribute)
    $(GLINK VisibilityAttribute)
    $(RELATIVE_LINK2 auto, $(D auto))
    $(RELATIVE_LINK2 immutable, $(D immutable))
    $(RELATIVE_LINK2 ref, $(D ref))
    $(RELATIVE_LINK2 static, $(D static))

$(GNAME DeclarationBlock):
    $(GLINK2 module, DeclDef)
    $(D {) $(GLINK2 module, DeclDefs)$(OPT) $(D })
)

$(P This grammar lists settled attribute-specifier forms. Each modifier is
still limited to the declaration kinds allowed by its defining chapter. In
particular, $(D static) does not permit mutable static storage, $(D ref) does
not permit reference results, and visibility is currently guaranteed only for
module imports.)

$(H2 $(LNAME2 linkage, Linkage Attributes))

$(GRAMMAR
$(GNAME LinkageAttribute):
    $(D extern) $(D $(LPAREN)) $(GLINK LinkageType) $(D $(RPAREN))

$(GNAME LinkageType):
    $(D D)
    $(D C)
    $(D C) $(D ++)
)

$(P $(D extern(D)) selects the native D ABI. $(D extern(C)) selects the target
C ABI and is the primary foreign-function interface. $(D extern(C++)) is
supported for free functions, function pointers, mangling, and overload sets.)

----------------
extern(C) int c_function(int value);
extern(C++) int cpp_function(int value);
----------------

$(LASER_EXCLUDED C++ linkage does not enable C++ structs, classes, interfaces,
or member functions. $(D extern(Objective-C)) and the Objective-C object model
are rejected.)

$(H3 $(LNAME2 namespace, C++ Namespaces))

$(LASER_UNDER_REVIEW C++ namespace-qualified linkage and the extended
$(D extern(C++, ...)) forms have not yet been classified. Simple C++
free-function linkage does not imply support for these forms.)

$(LASER_UNDER_REVIEW $(D extern(Windows)) and $(D extern(System)) remain to be
reviewed for their portable Laser-D boundary. ImportC applies the calling
convention rules required by its C input.)

$(H2 $(LNAME2 visibility_attributes, Visibility Attributes))

$(GRAMMAR
$(GNAME VisibilityAttribute):
    $(D private)
    $(D public)
)

$(P $(D private import) keeps imported symbols from being re-exported.
$(D public import) re-exports imported symbols. An unqualified import has the
default visibility specified by the modules chapter.)

$(LASER_UNDER_REVIEW General declaration visibility, $(D package),
$(D protected), and $(D export) have not yet been classified. Native classes
and interfaces are absent, so their protected-member model cannot apply.)

$(H3 $(LNAME2 private, $(D private)))

$(P On an import, $(D private) limits the binding to the importing module.)

$(H3 $(LNAME2 public, $(D public)))

$(P On an import, $(D public) makes the imported binding available to modules
that import the current module.)

$(H3 $(LNAME2 package, $(D package)))

$(LASER_UNDER_REVIEW Package visibility is part of the unresolved package
module and package hierarchy review.)

$(H3 $(LNAME2 export, $(D export)))

$(LASER_UNDER_REVIEW Export visibility and shared-library symbol publication
have not yet been specified for Laser-D.)

$(H2 $(LNAME2 mutability, Mutability and Storage Modifiers))

$(H3 $(LNAME2 immutable, $(D immutable)))

$(P $(D immutable) constructs a transitively immutable type or declaration as
defined by the type-qualifier chapter. It may be used for local values and for
static data whose initializer is compile-time evaluable.)

$(H3 $(LNAME2 static, $(D static)))

$(P $(D static) is available where a supported declaration uses static
membership or storage. Mutable module, function-static, and aggregate-static
storage is rejected; manifest constants and deeply immutable static data are
the supported static-data cases.)

$(H3 $(LNAME2 auto, $(D auto)))

$(P $(D auto) requests compile-time type inference from a required initializer.
It does not enable $(D auto ref), safety inference, purity inference, or
inference of a rejected type.)

$(H3 $(LNAME2 ref, $(D ref)))

$(P $(D ref) is supported for function parameters and local reference
variables under the declaration and function rules. Reference function results
and $(D auto ref) are rejected.)

$(H2 $(LNAME2 function-attributes, Implicit Function Attributes))

$(LASER_NORMATIVE Every Laser-D function and function type is implicitly
$(D nothrow), $(D @nogc), and $(D @system). The attributes are properties of
the type even though they cannot be written in source. Functions remain
conservatively impure.)

$(H3 $(LNAME2 nothrow, $(D nothrow)))

$(P No exception may escape a Laser-D function. Explicit $(D nothrow) is
rejected because it is mandatory and implicit.)

$(H3 $(LNAME2 nogc, $(D @nogc)))

$(P A Laser-D function cannot use a GC operation. Explicit $(D @nogc) is
rejected because it is mandatory and implicit.)

$(H3 $(LNAME2 safe, $(D @safe), $(D @trusted), and $(D @system)))

$(P Laser-D performs no D safety inference. Every function is implicitly
$(D @system); explicit $(D @system), $(D @safe), and $(D @trusted) are all
rejected. Pointer and lifetime correctness remain programmer responsibilities.)

$(H3 $(LNAME2 system-variables, System Variables (Excluded)))

$(P Explicit $(D @system) variables and fields are rejected with the explicit
safety-attribute surface. Laser-D does not distinguish a separate safety class
of variables.)

$(H3 $(LNAME2 pure, $(D pure)))

$(LASER_EXCLUDED $(D pure) is rejected. Laser-D functions are conservatively
impure, so the compiler does not promise absence of externally visible state.)

$(H3 $(LNAME2 property, $(D @property)))

$(LASER_EXCLUDED $(D @property) is rejected. Ordinary functions and methods
must be called with parentheses and cannot behave syntactically like fields.)

$(H2 $(LNAME2 shared-storage, Threading Attributes))

$(H3 $(LNAME2 shared, $(D shared)))

$(LASER_EXCLUDED $(D shared) is not a Laser-D type qualifier or declaration
attribute.)

$(H3 $(LNAME2 gshared, $(D __gshared)))

$(LASER_EXCLUDED $(D __gshared) is rejected because D-owned mutable global
state and native language-level threading are disabled.)

$(H3 $(LNAME2 synchronized, $(D synchronized)))

$(LASER_EXCLUDED $(D synchronized) declarations and statements are rejected.
Programs may call explicit C threading and synchronization APIs.)

$(H2 $(LNAME2 rejected_attributes, Other Rejected Attributes))

$(LASER_EXCLUDED $(D @live), $(D scope), $(D lazy), parameter/result
$(D return), $(D inout), $(D const), $(D final) parameters, $(D __rvalue),
$(D abstract), $(D final), and $(D override) are rejected in the source
locations governed by their corresponding feature decisions.)

$(H3 $(LNAME2 scope, $(D scope)))

$(P The parameter and variable $(D scope) annotation is rejected. The
$(D scope(exit)) statement is a separate cleanup statement and remains
supported.)

$(H3 $(LNAME2 scope-class-var, Scope Class Instances (Excluded)))

$(P Scope-managed class instances are unavailable because $(D scope), native
classes, class destruction, and language-managed allocation are all rejected.)

$(H3 $(LNAME2 __rvalue, $(D __rvalue)))

$(P $(D __rvalue) is rejected together with the related $(D __traits(isReturnOnStack))
surface.)

$(H2 $(LNAME2 uda, User-Defined Attributes))

$(H3 $(LNAME2 UserDefinedAttribute, User-Defined Attribute Syntax (Excluded)))

$(LASER_EXCLUDED User-defined attributes are rejected in every source
location. This includes $(D @(arguments)), $(D @identifier), UDA template
instances, and UDA call expressions. Supported $(D __traits(getAttributes))
queries remain useful to generic code but return an empty sequence for ordinary
Laser-D declarations.)

$(H2 $(LNAME2 attributes_under_review, Built-in Attributes Under Review))

$(LASER_UNDER_REVIEW The following built-in facilities are not yet Laser-D
guarantees: $(D align), $(D deprecated), $(D @disable), $(D @__future),
general visibility, $(D export), $(D pragma), and compiler-recognized special
attributes. They remain reserved syntax while their individual reviews are
pending.)

$(H3 $(LNAME2 align, $(D align)))

$(H4 $(LNAME2 AlignAttribute, Alignment Attribute Grammar (Under Review)))

$(P Explicit alignment control remains under review. The compile-time
$(D .alignof) property is supported independently.)

$(H3 $(LNAME2 deprecated, $(D deprecated)))

$(H4 $(LNAME2 DeprecatedAttribute, Deprecation Attribute Grammar (Under Review)))

$(P Source-level deprecation annotations and module deprecation remain under
review.)

$(H3 $(LNAME2 disable, $(D @disable)))

$(P Disabled declarations and disabled default construction remain under
review.)

$(H3 $(LNAME2 future, $(D @__future)))

$(P The implementation-reserved future attribute is not a portability
guarantee.)

$(H3 $(LNAME2 FunctionAttributeKwd, Explicit Function Attribute Keywords))

$(P Explicit $(D nothrow) and $(D pure) are rejected. The first is implicit;
the second is not a Laser-D function property.)

$(H3 $(LNAME2 AtAttribute, At-Sign Attributes))

$(P Settled at-sign attributes are rejected: safety attributes, $(D @nogc),
$(D @live), $(D @property), and UDAs. Remaining built-in at-sign attributes are
under review.)

$(H3 $(LNAME2 Property, Property Attribute (Excluded)))

$(P $(D @property) is excluded as described under implicit function
attributes.)

$(H2 $(LNAME2 class-attributes, Object-Oriented Attributes))

$(LASER_EXCLUDED Class-specific uses of $(D abstract), $(D final),
$(D override), and $(D synchronized) are absent with native classes and
interfaces.)

$(SPEC_SUBNAV_PREV_NEXT property, Properties, pragma, Pragmas)
)

Macros:
        CHAPTER=9
        TITLE=Attributes
