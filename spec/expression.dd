Ddoc

$(SPEC_S Expressions,

$(HEADERNAV_TOC)

$(LASER_NORMATIVE Expressions compute values, select storage, call functions,
and perform explicit side effects using supported Laser-D types. Expression
syntax never restores an excluded type, allocation model, runtime service, or
implicit function call.)

$(H2 $(LEGACY_LNAME2 Expression, expression, Expression Grammar))

$(GRAMMAR
$(GNAME Expression):
    $(GLINK CommaExpression)

$(GNAME CommaExpression):
    $(GLINK AssignExpression)
    $(GSELF CommaExpression) $(D ,) $(GLINK AssignExpression)

$(GNAME AssignExpression):
    $(GLINK ConditionalExpression)
    $(GLINK ConditionalExpression) $(D =) $(GSELF AssignExpression)
    $(GLINK ConditionalExpression) $(D +=) $(GSELF AssignExpression)
    $(GLINK ConditionalExpression) $(D -=) $(GSELF AssignExpression)
    $(GLINK ConditionalExpression) $(D *=) $(GSELF AssignExpression)
    $(GLINK ConditionalExpression) $(D /=) $(GSELF AssignExpression)
    $(GLINK ConditionalExpression) $(D %=) $(GSELF AssignExpression)
    $(GLINK ConditionalExpression) $(D &=) $(GSELF AssignExpression)
    $(GLINK ConditionalExpression) $(D |=) $(GSELF AssignExpression)
    $(GLINK ConditionalExpression) $(D ^=) $(GSELF AssignExpression)
    $(GLINK ConditionalExpression) $(D ~=) $(GSELF AssignExpression)
    $(GLINK ConditionalExpression) $(D <<=) $(GSELF AssignExpression)
    $(GLINK ConditionalExpression) $(D >>=) $(GSELF AssignExpression)
    $(GLINK ConditionalExpression) $(D >>>=) $(GSELF AssignExpression)
    $(GLINK ConditionalExpression) $(D ^^=) $(GSELF AssignExpression)

$(GNAME ConditionalExpression):
    $(GLINK OrOrExpression)
    $(GLINK OrOrExpression) $(D ?) $(GLINK Expression) $(D :) $(GSELF ConditionalExpression)

$(GNAME OrOrExpression):
    $(GLINK AndAndExpression)
    $(GSELF OrOrExpression) $(D ||) $(GLINK AndAndExpression)

$(GNAME AndAndExpression):
    $(GLINK OrExpression)
    $(GSELF AndAndExpression) $(D $(AMP)$(AMP)) $(GLINK OrExpression)

$(GNAME OrExpression):
    $(GLINK XorExpression)
    $(GSELF OrExpression) $(D |) $(GLINK XorExpression)

$(GNAME XorExpression):
    $(GLINK AndExpression)
    $(GSELF XorExpression) $(D ^) $(GLINK AndExpression)

$(GNAME AndExpression):
    $(GLINK CmpExpression)
    $(GSELF AndExpression) $(D &) $(GLINK CmpExpression)

$(GNAME CmpExpression):
    $(GLINK EqualExpression)
    $(GLINK IdentityExpression)
    $(GLINK RelExpression)
    $(GLINK InExpression)
    $(GLINK ShiftExpression)

$(GNAME EqualExpression):
    $(GLINK ShiftExpression) $(D ==) $(GLINK ShiftExpression)
    $(GLINK ShiftExpression) $(D !=) $(GLINK ShiftExpression)

$(GNAME IdentityExpression):
    $(GLINK ShiftExpression) $(D is) $(GLINK ShiftExpression)
    $(GLINK ShiftExpression) $(D ! is) $(GLINK ShiftExpression)

$(GNAME RelExpression):
    $(GLINK ShiftExpression) $(D <) $(GLINK ShiftExpression)
    $(GLINK ShiftExpression) $(D <=) $(GLINK ShiftExpression)
    $(GLINK ShiftExpression) $(D >) $(GLINK ShiftExpression)
    $(GLINK ShiftExpression) $(D >=) $(GLINK ShiftExpression)

$(GNAME InExpression):
    $(GLINK ShiftExpression) $(D in) $(GLINK ShiftExpression)
    $(GLINK ShiftExpression) $(D ! in) $(GLINK ShiftExpression)

$(GNAME ShiftExpression):
    $(GLINK AddExpression)
    $(GSELF ShiftExpression) $(D <<) $(GLINK AddExpression)
    $(GSELF ShiftExpression) $(D >>) $(GLINK AddExpression)
    $(GSELF ShiftExpression) $(D >>>) $(GLINK AddExpression)

$(GNAME AddExpression):
    $(GLINK MulExpression)
    $(GSELF AddExpression) $(D +) $(GLINK MulExpression)
    $(GSELF AddExpression) $(D -) $(GLINK MulExpression)
    $(GSELF AddExpression) $(D ~) $(GLINK MulExpression)

$(GNAME MulExpression):
    $(GLINK UnaryExpression)
    $(GSELF MulExpression) $(D *) $(GLINK UnaryExpression)
    $(GSELF MulExpression) $(D /) $(GLINK UnaryExpression)
    $(GSELF MulExpression) $(D %) $(GLINK UnaryExpression)

$(GNAME UnaryExpression):
    $(D $(AMP)) $(GSELF UnaryExpression)
    $(D ++) $(GSELF UnaryExpression)
    $(D --) $(GSELF UnaryExpression)
    $(D *) $(GSELF UnaryExpression)
    $(D -) $(GSELF UnaryExpression)
    $(D +) $(GSELF UnaryExpression)
    $(D !) $(GSELF UnaryExpression)
    $(GLINK ComplementExpression)
    $(GLINK CastExpression)
    $(GLINK PowExpression)

$(GNAME ComplementExpression):
    $(D ~) $(GLINK UnaryExpression)

$(GNAME CastExpression):
    $(D cast $(LPAREN)) $(GLINK2 type, Type) $(D $(RPAREN)) $(GLINK UnaryExpression)

$(GNAME PowExpression):
    $(GLINK PostfixExpression)
    $(GLINK PostfixExpression) $(D ^^) $(GLINK UnaryExpression)

$(GNAME PostfixExpression):
    $(GLINK PrimaryExpression)
    $(GSELF PostfixExpression) $(D .) $(IDENTIFIER)
    $(GSELF PostfixExpression) $(D .) $(GLINK2 template, TemplateInstance)
    $(GSELF PostfixExpression) $(D ++)
    $(GSELF PostfixExpression) $(D --)
    $(GSELF PostfixExpression) $(D $(LPAREN)) $(GLINK NamedArgumentList)$(OPT) $(D $(RPAREN))
    $(GLINK2 type, TypeCtors)$(OPT) $(GLINK2 type, BasicType) $(D $(LPAREN)) $(GLINK NamedArgumentList)$(OPT) $(D $(RPAREN))
    $(GSELF PostfixExpression) $(GLINK IndexOperation)
    $(GSELF PostfixExpression) $(GLINK SliceOperation)

$(GNAME ArgumentList):
    $(GLINK AssignExpression)
    $(GLINK AssignExpression) $(D ,)
    $(GLINK AssignExpression) $(D ,) $(GSELF ArgumentList)

$(GNAME NamedArgumentList):
    $(GLINK NamedArgument)
    $(GLINK NamedArgument) $(D ,)
    $(GLINK NamedArgument) $(D ,) $(GSELF NamedArgumentList)

$(GNAME NamedArgument):
    $(IDENTIFIER) $(D :) $(GLINK AssignExpression)
    $(GLINK AssignExpression)

$(GNAME IndexOperation):
    $(D [) $(GLINK ArgumentList) $(D ])

$(GNAME SliceOperation):
    $(D [ ])
    $(D [) $(GLINK Slice) $(D ])
    $(D [) $(GLINK Slice) $(D ,) $(D ])

$(GNAME Slice):
    $(GLINK AssignExpression)
    $(GLINK AssignExpression) $(D ,) $(GSELF Slice)
    $(GLINK AssignExpression) $(D ..) $(GLINK AssignExpression)
    $(GLINK AssignExpression) $(D ..) $(GLINK AssignExpression) $(D ,) $(GSELF Slice)
)

$(H2 $(LNAME2 definitions-and-terms, Values and Storage))

$(H3 $(LNAME2 .define-lvalue, Lvalues))

$(P An lvalue designates writable or addressable storage. Variables, mutable
fields, pointer dereferences, built-in array indexing, and assignments are
lvalues where their underlying storage is mutable. A slice value is not an
owner, but indexing a mutable slice designates its backing storage.)

$(P Function results are values, not lvalues, because Laser-D rejects reference
returns. Operator overloads likewise return values; index mutation uses
$(D opIndexAssign), $(D opIndexOpAssign), or $(D opIndexUnary) rather than a
reference-returning $(D opIndex).)

$(H3 $(LNAME2 .define-rvalue, Rvalues))

$(P Literals, manifest constants, function results, and other expressions not
designating storage are rvalues. Taking an address and binding a local
$(D ref) variable require an lvalue.)

$(H3 $(LNAME2 .define-full-expression, Full Expressions))

$(P A full expression is an expression not contained within another expression.
Temporary scalar and aggregate values live until the end of their full
expression. Laser-D has no destructor or postblit hook to run implicitly at
that boundary.)

$(H2 $(LNAME2 order-of-evaluation, Evaluation Order))

$(P Ordinary binary operands are evaluated left to right. $(D &&) and $(D ||)
evaluate the right operand only when required. The conditional operator
evaluates its condition and then exactly one branch. D-linkage call targets and
arguments are evaluated left to right; foreign linkage follows the applicable
ABI.)

$(H2 $(LNAME2 assign_expressions, Assignment))

$(H3 $(LNAME2 simple_assignment_expressions, Simple Assignment))

$(P The left operand must be a modifiable lvalue. The right operand converts to
the destination type. Struct assignment copies value storage without a
user-defined postblit. Fixed-array and slice assignment follow the arrays
chapter; assignment cannot resize a slice.)

$(H3 $(LNAME2 assignment_operator_expressions, Compound Assignment))

$(P $(D a op= b) evaluates $(D a) once, performs the corresponding operation,
and stores the converted result. Modern struct overloads use the operator
overloading hooks defined by that chapter.)

$(H2 $(LNAME2 logical_expressions, Logical and Conditional Expressions))

$(P $(D !), $(D &&), and $(D ||) use Boolean conversion. The latter two
short-circuit. $(D condition ? yes : no) evaluates only the selected branch and
produces their common supported type.)

$(H2 $(LNAME2 bitwise_expressions, Bitwise and Shift Expressions))

$(P $(D &), $(D |), $(D ^), $(D ~), $(D <<), $(D >>), and $(D >>>) operate on
integral values after the integer conversions defined by the types chapter.
A compile-time invalid shift count is rejected; invalid runtime shift counts
are implementation-defined.)

$(H2 $(LNAME2 compare_expressions, Comparisons))

$(H3 $(LNAME2 equality_expressions, Equality))

$(P $(D ==) and $(D !=) compare supported scalars, pointers, enums, structs
with supported equality, and compatible fixed arrays or slices. Slice equality
compares length and elements and does not allocate.)

$(H3 $(LNAME2 identity_expressions, Identity))

$(P $(D is) and $(D !is) compare representation identity. For pointers this
compares addresses; for slices it compares pointer and length. Laser-D has no
class or interface identity.)

$(H3 $(LNAME2 array_comparisons, Array and Slice Comparisons))

$(P Equality and identity are supported for compatible arrays and slices.
Ordered comparisons $(D <), $(D <=), $(D >), and $(D >=) are rejected because
their D implementation requires a runtime comparison hook.)

$(H3 $(LNAME2 struct_equality, Struct Equality))

$(P Struct equality uses a supported $(D opEquals) overload when present;
otherwise it compares fields according to their supported equality semantics.)

$(H3 $(LNAME2 class-comparisons, Class Comparisons (Excluded)))

$(LASER_EXCLUDED Class and interface comparisons are unavailable.)

$(H2 $(LNAME2 arithmetic_expressions, Arithmetic))

$(P Supported numeric values provide unary sign, addition, subtraction,
multiplication, division, remainder, and exponentiation under the conversions
defined by the types chapter. Integer overflow wraps to the destination width.
Integer division by zero and signed minimum divided by negative one are invalid;
when encountered at runtime their behavior is undefined.)

$(H3 $(LNAME2 pointer_arithmetic, Pointer Arithmetic))

$(P Adding or subtracting an integer from $(D T*) advances by multiples of
$(D T.sizeof). Subtracting pointers into the same object yields $(D ptrdiff_t).
Producing or dereferencing an invalid pointer is undefined.)

$(H3 $(LNAME2 CatExpression, Concatenation (Excluded)))

$(LASER_EXCLUDED Built-in array and string concatenation with $(D ~) or
$(D ~=) is rejected because it requires allocation. The tokens remain in the
grammar for modern operator overloading.)

$(H2 $(LNAME2 cast_expressions, Casts))

$(P $(D cast(T) expression) performs an explicit conversion to a supported
type $(D T). It cannot cast to a rejected scalar family, class, interface,
associative array, vector, or rejected qualifier.)

$(H3 $(LNAME2 cast_pointers, Pointer Casts))
$(P Pointer casts reinterpret an address and do not establish alignment,
lifetime, bounds, or ownership.)

$(H3 $(LNAME2 cast_array, Array and Slice Casts))
$(P Array and slice casts are limited by the fixed-storage and non-owning-view
rules in the arrays chapter.)

$(H3 $(LNAME2 cast_class, Class Casts (Excluded)))
$(LASER_EXCLUDED Class casts and runtime checked casts are unavailable.)

$(H2 $(LNAME2 postfix_expressions, Calls, Members, Indexing, and Slicing))

$(H3 $(LNAME2 argument-list, Function Arguments))

$(P Functions, function pointers, delegates, constructors, templates, operator
calls, and UFCS calls require an explicit parenthesized argument list. Named
and positional arguments bind to parameters once; omitted parameters must have
a supported default argument.)

$(H4 $(LNAME2 argument-parameter-matching, Argument Matching))

$(P Positional arguments bind in order. A named argument binds the parameter
with that name. A parameter cannot be bound twice. Every remaining parameter
must have a default.)

$(H3 $(LEGACY_LNAME2 index_operations, index_expressions, Indexing))

$(P Fixed arrays, slices, and pointers support one-dimensional indexing.
$(D $) is the current length where available. Struct operators may implement
one- and multidimensional indexing using the modern hooks.)

$(H3 $(LEGACY_LNAME2 slice_operations, slice_expressions, Slicing))

$(P Slicing fixed arrays, slices, or explicit pointer ranges produces a
non-owning slice. Bounds and lifetime remain the programmer's responsibility.
Modern struct hooks may implement dimension-tagged slicing.)

$(H2 $(LNAME2 primary_expressions, Primary Expressions))

$(GRAMMAR
$(GNAME PrimaryExpression):
    $(IDENTIFIER)
    $(D .) $(IDENTIFIER)
    $(GLINK2 template, TemplateInstance)
    $(D .) $(GLINK2 template, TemplateInstance)
    $(RELATIVE_LINK2 IndexOperation, $(D $))
    $(GLINK LiteralExpression)
    $(GLINK2 type, FundamentalType) $(D .) $(IDENTIFIER)
    $(GLINK2 type, TypeCtor)$(OPT) $(D $(LPAREN)) $(GLINK2 type, Type) $(D $(RPAREN) .) $(IDENTIFIER)
    $(GLINK2 type, FundamentalType) $(D $(LPAREN)) $(GLINK NamedArgumentList)$(OPT) $(D $(RPAREN))
    $(GLINK2 type, TypeCtor)$(OPT) $(D $(LPAREN)) $(GLINK2 type, Type) $(D $(RPAREN)) $(D $(LPAREN)) $(GLINK NamedArgumentList)$(OPT) $(D $(RPAREN))
    $(GLINK2 type, Typeof)
    $(GLINK IsExpression)
    $(D $(LPAREN)) $(GLINK Expression) $(D $(RPAREN))
    $(GLINK SpecialKeyword)
    $(GLINK2 traits, TraitsExpression)

$(GNAME LiteralExpression):
    $(RELATIVE_LINK2 this, $(D this))
    $(RELATIVE_LINK2 null, $(D null))
    $(LEGACY_LNAME2 true_false)$(DDSUBLINK spec/type, bool, $(D true))
    $(DDSUBLINK spec/type, bool, $(D false))
    $(GLINK_LEX IntegerLiteral)
    $(GLINK_LEX FloatLiteral)
    $(LEGACY_LNAME2 CharacterLiteral)$(LEGACY_LNAME2 character-literal)$(GLINK_LEX CharacterLiteral)
    $(RELATIVE_LINK2 string_literals, $(GLINK_LEX StringLiteral))
    $(GLINK FunctionLiteral)
)

$(H3 $(LNAME2 this, $(D this)))

$(P Inside a struct or union constructor or instance method, $(D this) denotes
the current value. Structs have no inheritance or hidden virtual table.)

$(H3 $(LNAME2 super, $(D super) (Excluded)))

$(LASER_EXCLUDED $(D super) has no meaning because Laser-D structs do not
inherit and native classes and interfaces are rejected.)

$(H3 $(LNAME2 null, $(D null)))

$(P $(D null) converts to a pointer, slice, function pointer, or delegate. It
does not represent a class or associative-array reference.)

$(H3 $(LEGACY_LNAME2 StringLiteral, string_literals, String Literals))

$(P String literals are immutable, compiler-provided static storage viewed
through a non-owning character slice.)

$(H3 $(LNAME2 function_literals, Function Literals))

$(GRAMMAR
$(GNAME FunctionLiteral):
    $(D function) $(GLINK BasicTypeWithSuffixes)$(OPT) $(GLINK2 function, Parameters)$(OPT) $(GLINK FunctionLiteralBody)
    $(D delegate) $(GLINK BasicTypeWithSuffixes)$(OPT) $(GLINK2 function, Parameters)$(OPT) $(GLINK FunctionLiteralBody)
    $(GLINK2 function, Parameters) $(GLINK FunctionLiteralBody)
    $(IDENTIFIER) $(D =>) $(GLINK AssignExpression)

$(GNAME BasicTypeWithSuffixes):
    $(GLINK2 type, BasicType) $(GLINK2 type, TypeSuffixes)$(OPT)

$(GNAME FunctionLiteralBody):
    $(D =>) $(GLINK AssignExpression)
    $(GLINK2 function, SpecifiedFunctionBody)
)

$(P Non-capturing function and delegate literals are supported, including
parameter and return-type inference. A literal that captures an enclosing local
variable is rejected. Function contracts, ref results, and $(D auto ref) are
also rejected.)

$(H4 $(LNAME2 lambda-type-inference, Lambda Type Inference))

$(P Omitted parameter or result types are inferred at compile time. Inference
cannot produce an excluded type or attribute.)

$(H3 $(LNAME2 is_expression, $(D is) Expressions))

$(GRAMMAR
$(GNAME IsExpression):
    $(D is $(LPAREN)) $(GLINK2 type, Type) $(D $(RPAREN))
    $(D is $(LPAREN)) $(GLINK2 type, Type) $(D :) $(GLINK TypeSpecialization) $(D $(RPAREN))
    $(D is $(LPAREN)) $(GLINK2 type, Type) $(D ==) $(GLINK TypeSpecialization) $(D $(RPAREN))
    $(D is $(LPAREN)) $(GLINK2 type, Type) $(IDENTIFIER) $(D $(RPAREN))
    $(D is $(LPAREN)) $(GLINK2 type, Type) $(IDENTIFIER) $(D :) $(GLINK TypeSpecialization) $(D $(RPAREN))
    $(D is $(LPAREN)) $(GLINK2 type, Type) $(IDENTIFIER) $(D ==) $(GLINK TypeSpecialization) $(D $(RPAREN))

$(GNAME TypeSpecialization):
    $(GLINK2 type, Type)
    $(GLINK2 type, TypeCtor)
    $(D struct)
    $(D union)
    $(D enum)
    $(D function)
    $(D delegate)
    $(D return)
    $(D __parameters)
    $(D module)
    $(D package)
)

$(P $(D is) performs compile-time validity, equivalence, conversion, category,
and pattern-deduction queries over the supported type system. Class,
interface, vector, and $(D super) specializations are absent.)

$(H3 $(LNAME2 specialkeywords, Special Keywords))

$(GRAMMAR
$(GNAME SpecialKeyword):
    $(D __FILE__)
    $(D __FILE_FULL_PATH__)
    $(D __MODULE__)
    $(D __LINE__)
    $(D __FUNCTION__)
    $(D __PRETTY_FUNCTION__)
)

$(P These keywords produce compile-time source-location and symbol strings or
the current source line. They allocate no runtime storage.)

$(H2 $(LNAME2 excluded_primary, Excluded Primary Expressions))

$(H3 $(LNAME2 array_literals, Array Literals (Excluded)))
$(H4 $(LNAME2 array-literal-heap, Runtime Array Literal Allocation))
$(LASER_EXCLUDED Dynamic array literal expressions are rejected. Fixed-array
and static-data initializers use declaration initializer syntax instead.)

$(H3 $(LNAME2 associative_array_literals, Associative Array Literals (Excluded)))
$(H4 $(LNAME2 AssocArrayLiteral, Associative Array Literal Grammar))
$(LASER_EXCLUDED Associative-array types and literals are rejected.)

$(H3 $(LNAME2 mixin_expressions, String Mixin Expressions (Excluded)))
$(LASER_EXCLUDED Compile-time source-text injection with $(D mixin(expression))
is rejected. Template mixins are separate.)

$(H3 $(LNAME2 import_expressions, Compile-Time Import Expressions (Excluded)))
$(LASER_EXCLUDED $(D import("file")) is rejected because source-selected
compile-time file I/O is disabled.)

$(H3 $(LNAME2 new_expressions, $(D new) Expressions (Excluded)))
$(H4 $(LNAME2 NewExpression, New Expression Grammar))
$(LASER_EXCLUDED Every $(D new) form is rejected, including scalar, struct,
array, placement, class, and allocator forms.)

$(H3 $(LNAME2 typeid_expressions, $(D typeid) Expressions (Excluded)))
$(LASER_EXCLUDED $(D typeid) is rejected because runtime $(D TypeInfo) is
absent.)

$(H3 $(LNAME2 RvalueExpression, $(D __rvalue) Expression (Excluded)))
$(LASER_EXCLUDED $(D __rvalue(expression)) is rejected. Laser-D exposes no
unchecked move or ownership hint.)

$(H3 $(LNAME2 delete_expressions, $(D delete) Expressions (Excluded)))
$(LASER_EXCLUDED $(D delete) is rejected with GC ownership and class
destruction.)

$(H3 $(LNAME2 throw_expression, Throw Expressions (Excluded)))
$(LASER_EXCLUDED Throw expressions are rejected with D exception handling.)

$(H2 $(LNAME2 expressions_under_review, Expressions Under Review))

$(H3 $(LNAME2 assert_expressions, Assert Expressions))
$(H4 $(LNAME2 AssertExpression, Assert Expression Grammar))
$(LASER_REJECTED Runtime $(D assert(condition)), message forms, and
$(D assert(0)) are rejected. Laser-D does not provide the druntime assertion
failure hooks, and runtime checks do not disappear according to release or
check-action compiler options. Programs use explicit conditions, return
values, or C-compatible error reporting.)

$(H4 $(LNAME2 assert-ct, Compile-Time Assertions))
$(LASER_SUPPORTED $(D static assert(condition)) and
$(D static assert(condition, message)) are supported. They are evaluated by
the compiler and produce no runtime code. An ordinary runtime $(D assert)
inside a CTFE-capable function remains rejected; CTFE does not change its
source-language classification. ImportC retains C $(D _Static_assert).)

$(H3 $(LNAME2 interpolation_expressions, Interpolation Expressions))
$(LASER_UNDER_REVIEW Interpolation expression sequences remain to be reviewed
and are not currently a Laser-D portability guarantee.)

$(SPEC_SUBNAV_PREV_NEXT pragma, Pragmas, statement, Statements)
)

Macros:
        CHAPTER=11
        TITLE=Expressions
