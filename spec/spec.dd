Ddoc

$(TOC Laser-D Language Reference,
        $(P This is the specification for Laser-D, or Lesser-D: a deliberately
        smaller D dialect with a C-like runtime model. The reference is being
        converted category by category; see the
        $(A intro.html#document-status, document-status rules) before treating
        unconverted upstream text as normative.))

$(H2 Normative Language Core)

$(TOC_LISTING $(ITEMIZE
        $(A intro.html, Introduction),
        $(A lex.html, Lexical Structure),
        $(A grammar.html, Grammar),
        $(A module.html, Modules),
        $(A declaration.html, Declarations),
        $(A type.html, Types),
        $(A property.html, Compiler-Provided Properties),
        $(A attribute.html, Attributes),
        $(A expression.html, Expressions),
        $(A statement.html, Statements),
        $(A arrays.html, Fixed Arrays and Non-Owning Slices),
        $(A struct.html, Structs and Unions),
        $(A enum.html, Enums),
        $(A const3.html, Type Qualifiers),
        $(A function.html, Functions),
        $(A operatoroverloading.html, Operator Overloading),
        $(A template.html, Templates and CTFE),
        $(A template-mixin.html, Template Mixins),
        $(A traits.html, Traits),
        $(A float.html, Floating-Point Arithmetic)
))

$(H2 Interoperability and Portability)

$(TOC_LISTING $(ITEMIZE
        $(A importc.html, ImportC),
        $(A interfaceToC.html, Interfacing to C),
        $(A cpp_interface.html, Supported C++ Interoperability),
        $(A abi.html, Application Binary Interface),
        $(A portability.html, Portability Guide),
        $(A glossary.html, Glossary)
))

$(H2 Areas Under Review)

$(P These chapters contain D material whose Laser-D boundary is incomplete.
They are not language guarantees except where an explicit Laser-D decision and
test say otherwise.)

$(TOC_LISTING $(ITEMIZE
        $(A istring.html, Interpolation Expressions),
        $(A pragma.html, Pragmas),
        $(A version.html, Conditional Compilation),
        $(A unittest.html, Unit Tests),
        $(A ddoc.html, Embedded Documentation),
        $(A entity.html, Named Character Entities),
        $(A windows.html, Windows Programming),
        $(A legacy.html, Legacy Code),
        $(A editions.html, Editions)
))

$(H2 Excluded D Facilities)

$(P The following chapters are retained temporarily to document exclusions and
to assist comparison with upstream D. Their D feature descriptions are not
Laser-D language definitions.)

$(TOC_LISTING $(ITEMIZE
        $(A hash-map.html, Associative Arrays),
        $(A class.html, Classes),
        $(A interface.html, Interfaces),
        $(A contracts.html, Function Contracts),
        $(A errors.html, D Exception Handling),
        $(A garbage.html, Garbage Collection),
        $(A iasm.html, Inline Assembly),
        $(A objc_interface.html, Objective-C Interoperability),
        $(A memory-safe-d.html, D Safety Attributes),
        $(A simd.html, Vector Extensions),
        $(A betterc.html, BetterC Compatibility Notes),
        $(A ob.html, Live Functions)
))

Macros:
        TITLE=Laser-D Language Reference
        BODY_PREFIX=$(COMMENT Suppress numbering in this page)
