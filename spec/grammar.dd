Ddoc

$(SPEC_S Grammar,

$(P The Laser-D grammar defines the source forms accepted before semantic
restrictions are applied. After the lexical analyzer creates tokens, the parser
organizes them into modules, declarations, types, statements, and expressions.)

$(UL
$(LI A $(DDSUBLINK spec/module, Module, *Module*) contains declarations.)
$(LI Declarations include variables, functions, aliases, enums, structs,
unions, and templates.)
$(LI Functions contain explicit block statements; function contracts and
contract-style $(D do) bodies are not grammar alternatives.)
$(LI Types include supported scalar, pointer, function, aggregate, fixed-array,
and non-owning slice forms.)
$(LI Expressions and statements use only productions retained by their
normative Laser-D chapters.)
)

$(P A production being syntactically valid does not make it semantically valid.
For example, template contents remain subject to the same type, allocation,
lifetime, and runtime restrictions as non-template source.)

$(H2 $(LNAME2 transition, Grammar Conversion Status))

$(P The aggregate summary below is generated from grammar fragments distributed
throughout the specification chapters. Those fragments are being converted
category by category from upstream D to Laser-D.)

$(NOTE Until that conversion is complete, the aggregate summary is a
transitional editing aid, not an independent grant of Laser-D syntax. A
production classified as rejected elsewhere is not part of Laser-D even if it
still appears below. Each category conversion must update its source grammar,
prose, and tests together.)

$(HEADERNAV_TOC)

$(H2 Transitional Aggregate Grammar)

$(GRAMMAR_SUMMARY)

$(SPEC_SUBNAV_PREV_NEXT istring, Interpolation Expression Sequence, module, Modules)
)

Macros:
        CHAPTER=4
        TITLE=Laser-D Grammar
        IDENTIFIER=$(GLINK Identifier)
        EXPRESSION=$(GLINK Expression)
        ASSIGNEXPRESSION=$(GLINK AssignExpression)
        PSSEMI_PSCURLYSCOPE=$(GLINK Statement)
        PSSEMI_PSCURLYSCOPE_LIST=$(GLINK ScopeStatementList)
        PS0=$(GLINK NoScopeNonEmptyStatement)
        PSSCOPE=$(GLINK ScopeStatement)
        PSCURLY=$(GLINK BlockStatement)
        PSSEMI=$(GLINK NoScopeStatement)
        PSCURLY_PSSCOPE=$(GLINK ScopeBlockStatement)
        PSCURLYSCOPE=$(GLINK NonEmptyOrScopeBlockStatement)
        TRAITS_LINK2=$(LINK2 traits.html#$1, $(D $1))
        GLINK2=$(GLINK $2)
        GRAMMAR_SUMMARY=$0
