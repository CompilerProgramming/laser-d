Ddoc

$(SPEC_S Statements,

$(HEADERNAV_TOC)

$(P Statements control execution within a function and have no value. Laser-D
supports blocks, expressions, declarations, returns, structured scalar control
flow, direct fixed-array/slice and numeric-range iteration, integral and enum
switches, explicit control transfers, imports, compile-time statements, and
$(D scope(exit)) cleanup.)

$(H2 $(LNAME2 grammar, Statement Grammar))

$(GRAMMAR
$(GNAME Statement):
    $(GLINK EmptyStatement)
    $(GLINK NonEmptyStatement)
    $(GLINK ScopeBlockStatement)

$(GNAME EmptyStatement):
    $(D ;)

$(GNAME NoScopeNonEmptyStatement):
    $(GLINK NonEmptyStatement)
    $(GLINK BlockStatement)

$(GNAME NoScopeStatement):
    $(GLINK EmptyStatement)
    $(GLINK NonEmptyStatement)
    $(GLINK BlockStatement)

$(GNAME NonEmptyOrScopeBlockStatement):
    $(GLINK NonEmptyStatement)
    $(GLINK ScopeBlockStatement)

$(GNAME NonEmptyStatement):
    $(GLINK ExpressionStatement)
    $(GLINK DeclarationStatement)
    $(GLINK ReturnStatement)
    $(GLINK ScopeGuardStatement)
    $(GLINK2 module, ImportDeclaration)
    $(GLINK2 version, ConditionalStatement)
    $(GLINK2 version, StaticForeachStatement)
    $(GLINK LabeledStatement)
    $(GLINK IfStatement)
    $(GLINK WhileStatement)
    $(GLINK DoStatement)
    $(GLINK ForStatement)
    $(GLINK ForeachStatement)
    $(GLINK ForeachRangeStatement)
    $(GLINK SwitchStatement)
    $(GLINK FinalSwitchStatement)
    $(GLINK CaseStatement)
    $(GLINK CaseRangeStatement)
    $(GLINK DefaultStatement)
    $(GLINK ContinueStatement)
    $(GLINK BreakStatement)
    $(GLINK GotoStatement)
    $(GLINK WithStatement)

$(GNAME NonEmptyStatementNoCaseNoDefault):
    $(GLINK ExpressionStatement)
    $(GLINK DeclarationStatement)
    $(GLINK ReturnStatement)
    $(GLINK ScopeGuardStatement)
    $(GLINK2 module, ImportDeclaration)
    $(GLINK2 version, ConditionalStatement)
    $(GLINK2 version, StaticForeachStatement)
    $(GLINK LabeledStatement)
    $(GLINK IfStatement)
    $(GLINK WhileStatement)
    $(GLINK DoStatement)
    $(GLINK ForStatement)
    $(GLINK ForeachStatement)
    $(GLINK ForeachRangeStatement)
    $(GLINK SwitchStatement)
    $(GLINK FinalSwitchStatement)
    $(GLINK ContinueStatement)
    $(GLINK BreakStatement)
    $(GLINK GotoStatement)
    $(GLINK WithStatement)

$(GNAME ScopeStatement):
    $(GLINK NonEmptyStatement)
    $(GLINK BlockStatement)

$(GNAME ScopeBlockStatement):
    $(GLINK BlockStatement)

$(GNAME BlockStatement):
    $(D { })
    $(D {) $(GLINK StatementList) $(D })

$(GNAME StatementList):
    $(PSSEMI_PSCURLYSCOPE)
    $(PSSEMI_PSCURLYSCOPE) $(GSELF StatementList)

$(GNAME ExpressionStatement):
    $(EXPRESSION) $(D ;)

$(GNAME DeclarationStatement):
    $(GLINK2 declaration, StorageClasses)$(OPT) $(GLINK2 declaration, Declaration)

$(GNAME ReturnStatement):
    $(D return) $(D ;)
    $(D return) $(EXPRESSION) $(D ;)

$(GNAME ScopeGuardStatement):
    $(D scope $(LPAREN) exit $(RPAREN)) $(GLINK NonEmptyOrScopeBlockStatement)
)

$(P Each statement alternative remains subject to its section below. Advanced
iteration protocols and conditional-compilation forms that are still under
review are not implied by the surrounding statement grammar.)

$(H2 $(LEGACY_LNAME2 BlockStatement, block-statement, Blocks and Scope))

$(LASER_NORMATIVE A block is a lexical sequence of statements enclosed by
braces. Local names follow D lexical-scope rules. Leaving a block ends the
lifetime of its automatic storage, but Laser-D runs no destructor or postblit
hook implicitly.)

$(H2 $(LEGACY_LNAME2 ExpressionStatement, expression-statement, Expression Statements))

$(P An expression statement evaluates an expression for its side effects. An
expression with no effect is rejected unless explicitly converted to
$(D void).)

----------------
int value;
++value;
cast(void)(value + 1);
----------------

$(H2 $(LEGACY_LNAME2 DeclarationStatement, declaration-statement, Declaration Statements))

$(P A declaration statement introduces a supported local variable, alias,
type, function, template, import, or compile-time declaration. It remains
subject to the declarations chapter.)

$(H2 $(LEGACY_LNAME2 ReturnStatement, return-statement, Return Statements))

$(LASER_NORMATIVE $(D return;) exits a function with no result.
$(D return expression;) converts the expression to the function's value result
type and exits. Reference returns are unavailable.)

$(P Before control leaves, active $(D scope(exit)) guards execute in reverse
order of registration. No exception unwinding or module lifecycle action is
performed.)

$(H2 $(LEGACY_LNAME2 ScopeGuardStatement, scope-guard-statement, Deterministic Cleanup))

$(LASER_NORMATIVE $(D scope(exit)) is Laser-D's sole language-level cleanup
syntax. Its statement executes exactly once when control leaves the enclosing
lexical scope after the guard has been reached, including by fall-through,
$(D return), or another supported control transfer.)

----------------
extern(C) void release(int handle);

int use(int handle)
{
    scope(exit) release(handle);
    return handle;
}
----------------

$(P Multiple guards in one scope execute in last-in, first-out order. A guard
body cannot transfer control out of itself. Cleanup must be explicit about any
failure state because Laser-D has no exception-success distinction.)

$(LASER_EXCLUDED $(D scope(success)) and $(D scope(failure)) are rejected.
There is no exception state on which their distinction could depend.)

$(H2 $(LNAME2 compile_time_statements, Compile-Time Statements))

$(P $(D static if), $(D static foreach), and $(D static assert) are supported
as compile-time selection, iteration, and validation. Templates and CTFE remain
subject to every ordinary Laser-D restriction.)

$(P The shared upstream $(I ConditionalStatement) grammar also contains
$(D version) and $(D debug) forms. Those forms remain under review and are not
implied by support for $(D static if).)

$(H2 $(LNAME2 ordinary_control_flow, Ordinary Control Flow))

$(LASER_NORMATIVE Laser-D supports $(D if), $(D while), $(D do), $(D for),
direct $(D foreach) and $(D foreach_reverse), numeric range foreach,
$(D switch), $(D final switch), $(D break), $(D continue), labels, $(D goto),
and $(D with) under the restrictions below.)

$(H3 $(LEGACY_LNAME2 IfStatement, if-statement, If Statement))

$(GRAMMAR
$(GNAME IfStatement):
    $(D if $(LPAREN)) $(EXPRESSION) $(D $(RPAREN)) $(GLINK ScopeStatement)
    $(D if $(LPAREN)) $(EXPRESSION) $(D $(RPAREN)) $(GLINK ScopeStatement) $(D else) $(GLINK ScopeStatement)

$(GNAME ThenStatement):
    $(GLINK ScopeStatement)

$(GNAME ElseStatement):
    $(GLINK ScopeStatement)
)

$(H4 $(LNAME2 boolean-conditions, Boolean Conditions))

$(P A condition accepts $(D bool) or a supported scalar value with the Boolean
conversion defined by the types chapter. Arrays, structs without an overload,
and rejected reference types do not have an implicit truth value.)

$(H3 $(LEGACY_LNAME2 WhileStatement, while-statement, While Statement))
$(GRAMMAR
$(GNAME WhileStatement):
    $(D while $(LPAREN)) $(EXPRESSION) $(D $(RPAREN)) $(GLINK ScopeStatement)
)

$(H3 $(LEGACY_LNAME2 DoStatement, do-statement, Do Statement))
$(GRAMMAR
$(GNAME DoStatement):
    $(D do) $(GLINK ScopeStatement) $(D while $(LPAREN)) $(EXPRESSION) $(D $(RPAREN) ;)
)

$(H3 $(LEGACY_LNAME2 ForStatement, for-statement, For Statement))
$(GRAMMAR
$(GNAME ForStatement):
    $(D for $(LPAREN)) $(GLINK NoScopeStatement) $(EXPRESSION)$(OPT) $(D ;) $(EXPRESSION)$(OPT) $(D $(RPAREN)) $(GLINK ScopeStatement)
)

$(H3 $(LEGACY_LNAME2 ForeachStatement, foreach-statement, Foreach Statement))
$(H4 $(LNAME2 foreach_over_arrays, Foreach over Arrays and Slices))
$(H4 $(LNAME2 foreach_over_tuples, Foreach over Compile-Time Sequences))
$(H4 $(LNAME2 foreach_over_associative_arrays, Associative-Array Foreach (Excluded)))

$(GRAMMAR
$(GNAME AggregateForeach):
    $(GLINK Foreach) $(D $(LPAREN)) $(GLINK ForeachTypeList) $(D ;) $(GLINK ForeachAggregate) $(D $(RPAREN))

$(GNAME ForeachStatement):
    $(GLINK AggregateForeach) $(GLINK NoScopeNonEmptyStatement)

$(GNAME Foreach):
    $(D foreach)
    $(D foreach_reverse)

$(GNAME ForeachTypeList):
    $(GLINK ForeachType)
    $(GLINK ForeachType) $(D ,) $(GSELF ForeachTypeList)

$(GNAME ForeachType):
    $(GLINK ForeachTypeAttributes)$(OPT) $(GLINK2 type, BasicType) $(GLINK2 declaration, Declarator)
    $(GLINK ForeachTypeAttributes)$(OPT) $(GLINK_LEX Identifier)
    $(GLINK ForeachTypeAttributes)$(OPT) $(D alias) $(GLINK_LEX Identifier)

$(GNAME ForeachTypeAttributes):
    $(GLINK ForeachTypeAttribute)
    $(GLINK ForeachTypeAttribute) $(GSELF ForeachTypeAttributes)

$(GNAME ForeachTypeAttribute):
    $(D enum)
    $(D ref)
    $(GLINK2 type, TypeCtor)

$(GNAME ForeachAggregate):
    $(EXPRESSION)

$(GNAME RangeForeach):
    $(GLINK Foreach) $(D $(LPAREN)) $(GLINK ForeachType) $(D ;) $(GLINK LwrExpression) $(D ..) $(GLINK UprExpression) $(D $(RPAREN))

$(GNAME LwrExpression):
    $(EXPRESSION)

$(GNAME UprExpression):
    $(EXPRESSION)

$(GNAME ForeachRangeStatement):
    $(GLINK RangeForeach) $(PSSCOPE)
)

$(P Associative-array iteration is excluded with associative arrays. Direct
array, slice, and numeric-range forms are supported. Implicit $(D opApply),
user-defined range, delegate, and runtime compile-time-sequence iteration remain
under review.)

$(H3 $(LEGACY_LNAME2 SwitchStatement, switch-statement, Switch Statements))

$(H4 $(LEGACY_LNAME2 FinalSwitchStatement, final-switch-statement, Final Switch Statement))

$(GRAMMAR
$(GNAME SwitchStatement):
    $(D switch $(LPAREN)) $(EXPRESSION) $(D $(RPAREN)) $(GLINK ScopeStatement)

$(GNAME FinalSwitchStatement):
    $(D final switch $(LPAREN)) $(EXPRESSION) $(D $(RPAREN)) $(GLINK ScopeStatement)

$(GNAME CaseStatement):
    $(D case) $(GLINK2 expression, ArgumentList) $(D :) $(GLINK ScopeStatementList)

$(GNAME CaseRangeStatement):
    $(D case) $(EXPRESSION) $(D :) $(D ..) $(D case) $(EXPRESSION) $(D :) $(GLINK ScopeStatementList)

$(GNAME DefaultStatement):
    $(D default :) $(GLINK ScopeStatementList)

$(GNAME ScopeStatementList):
    $(PSSEMI_PSCURLYSCOPE_LIST)

$(GNAME StatementListNoCaseNoDefault):
    $(GLINK StatementNoCaseNoDefault)
    $(GLINK StatementNoCaseNoDefault) $(GSELF StatementListNoCaseNoDefault)

$(GNAME StatementNoCaseNoDefault):
    $(GLINK EmptyStatement)
    $(GLINK NonEmptyStatementNoCaseNoDefault)
    $(GLINK ScopeBlockStatement)
)

$(P Integral and enum switches are supported, including case ranges,
$(D final switch), $(D goto case), and $(D goto default). String and character
slice switches are rejected because they require the unavailable
$(D object.__switch) runtime hook.)

$(H3 $(LEGACY_LNAME2 ContinueStatement, continue-statement, Continue Statement))
$(GRAMMAR
$(GNAME ContinueStatement):
    $(D continue ;)
    $(D continue) $(GLINK_LEX Identifier) $(D ;)
)

$(H3 $(LEGACY_LNAME2 BreakStatement, break-statement, Break Statement))
$(GRAMMAR
$(GNAME BreakStatement):
    $(D break ;)
    $(D break) $(GLINK_LEX Identifier) $(D ;)
)

$(H3 $(LEGACY_LNAME2 LabeledStatement, labeled-statement, Labels and Goto))
$(GRAMMAR
$(GNAME LabeledStatement):
    $(GLINK_LEX Identifier) $(D :)
    $(GLINK_LEX Identifier) $(D :) $(PSSEMI_PSCURLYSCOPE)

$(GNAME GotoStatement):
    $(D goto) $(GLINK_LEX Identifier) $(D ;)
    $(D goto default ;)
    $(D goto case ;)
    $(D goto case) $(EXPRESSION) $(D ;)
)

$(P Labels, ordinary $(D goto), labeled $(D break) and $(D continue), and
switch-targeted goto forms are supported. A transfer leaving a lexical scope
executes its active $(D scope(exit)) guards.)

$(H3 $(LEGACY_LNAME2 WithStatement, with-statement, With Statement))
$(GRAMMAR
$(GNAME WithStatement):
    $(D with $(LPAREN)) $(EXPRESSION) $(D $(RPAREN)) $(GLINK ScopeStatement)
)

$(P $(D with) is supported for retained value types, enums, and namespaces. It
does not enable classes, interfaces, or implicit function calls.)

$(H2 $(LNAME2 rejected_statements, Rejected Statements))

$(H3 $(LEGACY_LNAME2 TryStatement, try-statement, Exception Statements))
$(H4 $(LNAME2 TryStatement, Try Statement Grammar))

$(LASER_EXCLUDED Source $(D try), $(D catch), $(D finally), and $(D throw) are
rejected. Errors must be represented and propagated explicitly through values
or C APIs. Internal frontend nodes used to lower $(D scope(exit)) are not
source-language features.)

$(H3 $(LEGACY_LNAME2 SynchronizedStatement, synchronized-statement, Synchronized Statements))
$(LASER_EXCLUDED $(D synchronized) is rejected. Explicit C threading, atomics,
and locking APIs remain available.)

$(H3 $(LNAME2 asm, Inline Assembly))
$(LASER_EXCLUDED D and GCC-style inline assembly statements are rejected in
Laser-D source. ImportC assembly remains a separate ImportC review.)

$(H3 $(LEGACY_LNAME2 MixinStatement, mixin-statement, String Mixin Statements))
$(LASER_EXCLUDED String mixin statements are rejected. Template mixins are
declaration constructs and remain separately supported.)

$(H3 $(LEGACY_LNAME2 PragmaStatement, pragma-statement, Pragma Statements))
$(LASER_UNDER_REVIEW Pragmas remain under review except that compile-time
$(D pragma(msg)) output is explicitly rejected.)

$(SPEC_SUBNAV_PREV_NEXT expression, Expressions, arrays, Arrays)
)

Macros:
        CHAPTER=12
        TITLE=Statements
