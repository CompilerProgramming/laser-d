Ddoc

$(SPEC_S Compiler-Provided Properties,

$(HEADERNAV_TOC)

$(LASER_NORMATIVE Compiler-provided properties are supported when they expose
compile-time metadata or an allocation-free view of a supported value. A
property cannot introduce a rejected type, allocate storage, resize a value, or
invoke user-defined behavior.)

$(LASER_EXCLUDED User-defined $(D @property) functions are not part of Laser-D.
All ordinary functions, methods, UFCS calls, and templates require explicit
call parentheses. Source-defined behavior therefore cannot masquerade as field
access.)

$(H2 $(LNAME2 common, Common Properties))

$(TABLE2 Common Properties,
$(THEAD Property, Result)
$(TROW $(RELATIVE_LINK2 stringof, $(D .stringof)), compile-time source representation)
$(TROW $(RELATIVE_LINK2 mangleof, $(D .mangleof)), compile-time mangled representation)
)

$(H2 $(LNAME2 type, Type and Layout Properties))

$(TABLE2 Type Properties,
$(THEAD Property, Result)
$(TROW $(RELATIVE_LINK2 init, $(D .init)), default initializer)
$(TROW $(RELATIVE_LINK2 sizeof, $(D .sizeof)), size in bytes)
$(TROW $(RELATIVE_LINK2 alignof, $(D .alignof)), required alignment in bytes)
$(TROW $(RELATIVE_LINK2 tupleof, $(D .tupleof)), aggregate field symbol sequence)
$(TROW $(RELATIVE_LINK2 offsetof, $(D .offsetof)), byte offset of an aggregate field)
)

$(P These properties are compile-time values. Layout results are target ABI
properties and may differ between supported targets.)

$(H2 $(LNAME2 numeric, Numeric Properties))

$(P Supported integral types provide $(D .min) and $(D .max). Supported
floating-point types $(D float) and $(D double) provide:)

$(TABLE2 Floating-Point Properties,
$(THEAD Property, Meaning)
$(TROW $(D .infinity), positive infinity)
$(TROW $(D .nan), quiet not-a-number value)
$(TROW $(D .dig), decimal precision)
$(TROW $(D .epsilon), increment from one)
$(TROW $(D .mant_dig), significand precision in bits)
$(TROW $(D .max_10_exp), maximum base-10 exponent)
$(TROW $(D .max_exp), maximum base-2 exponent)
$(TROW $(D .min_10_exp), minimum normalized base-10 exponent)
$(TROW $(D .min_exp), minimum normalized base-2 exponent)
$(TROW $(D .max), largest finite value)
$(TROW $(D .min_normal), smallest positive normalized value)
$(TROW $(D .re), the value itself)
)

$(LASER_EXCLUDED Numeric properties on $(D real), imaginary, complex, 128-bit
integer, or vector types are unavailable because those types are rejected.)

$(LASER_EXCLUDED The legacy floating-point $(D .im) property is not part of
Laser-D. It belongs to D's imaginary and complex number model, whose types are
rejected. An aggregate may still declare an ordinary field named $(D im).)

$(H2 $(LNAME2 init, $(D .init) Property))

$(P $(D T.init) is the compile-time default initializer for $(D T). Applying
$(D .init) to a variable, field, or expression yields the default initializer
of its type; it does not read or evaluate the value.)

$(TABLE2 Default Initializers,
$(THEAD Type category, Default)
$(TROW $(D bool), $(D false))
$(TROW integer types, zero)
$(TROW $(D float) and $(D double), not-a-number)
$(TROW character types, their specified invalid code-unit sentinel)
$(TROW pointers, slices, function pointers, and delegates, $(D null))
$(TROW fixed arrays, each element's default)
$(TROW structs, each field's declared or type default)
$(TROW unions, the selected default field described by the union rules)
$(TROW enums, the enum initializer described by the enum rules)
)

$(H3 $(LNAME2 init-vs-construction, $(D .init) and Construction))

$(P $(D .init) does not call a constructor. It produces the structural default
value. A struct constructor is an explicitly invoked function-like operation
and may produce a different value.)

----------------
struct Point
{
    int x;
    int y = 2;
}

static assert(Point.init.x == 0);
static assert(Point.init.y == 2);
----------------

$(H2 $(LNAME2 stringof, $(D .stringof) Property))

$(P $(D value.stringof) is a compile-time string containing the frontend's
source representation of its prefix. The prefix is not evaluated. Formatting
is implementation-defined and must not be used to generate source code.)

----------------
static assert(int.stringof == "int");
static assert((1 + 2).stringof == "1 + 2");
----------------

$(H2 $(LNAME2 sizeof, $(D .sizeof) Property))

$(P $(D T.sizeof) is the number of bytes occupied by a value of type $(D T).
For an expression or field it is the size of that expression's type. It does
not evaluate an expression or require an aggregate instance.)

----------------
struct Pair { int first; int second; }
static assert(int.sizeof == 4);
static assert(Pair.first.sizeof == int.sizeof);
----------------

$(H2 $(LNAME2 alignof, $(D .alignof) Property))

$(P $(D T.alignof) is the byte alignment required by type $(D T) on the target
ABI. It describes type layout and does not request or change alignment.)

$(H2 $(LNAME2 offsetof, $(D .offsetof) Property))

$(P $(D Aggregate.field.offsetof) is the byte offset of a non-static struct or
union field from the beginning of its containing value. It is a compile-time
ABI value.)

$(H2 $(LNAME2 mangleof, $(D .mangleof) Property))

$(P $(D symbol.mangleof) or $(D T.mangleof) is a compile-time string containing
the object-file name or type encoding selected by the applicable linkage and
ABI. Non-D linkage follows the target interoperability rules.)

$(H2 $(LNAME2 tupleof, $(D .tupleof) Property))

$(P $(D Aggregate.tupleof) or $(D value.tupleof) is a compile-time symbol
sequence containing the non-static fields of a supported struct or union in
declaration order. Iterating it does not allocate runtime storage.)

----------------
struct Vector2 { int x; int y; }
static assert(Vector2.tupleof.length == 2);
----------------

$(H2 $(LNAME2 arrays, Array and Slice Properties))

$(P Fixed arrays and non-owning slices provide read-only $(D .length) and
$(D .ptr). Fixed-array length is part of the type. Slice length and pointer are
the two components of the view. Assigning to slice $(D .length) is rejected.)

$(LASER_EXCLUDED $(D .dup), $(D .idup), $(D .capacity), reservation, resizing,
and other GC-backed array properties are unavailable.)

$(H2 $(LNAME2 delegates, Delegate Properties))

$(P A supported delegate provides $(D .ptr), its context pointer, and
$(D .funcptr), its function pointer. These properties expose the fixed-size
delegate representation and do not allocate. A non-capturing delegate has a
null context pointer.)

$(H2 $(LNAME2 enums, Enum Properties))

$(P Supported enums provide $(D .init), $(D .min), $(D .max), and layout
properties as defined by the enum chapter. Opaque enums have no usable default
initializer until defined.)

$(H2 $(LNAME2 classinfo, Excluded Runtime Properties))

$(LASER_EXCLUDED $(D .classinfo), runtime $(D TypeInfo), class layout
properties, associative-array properties, and vector properties are not part
of Laser-D. Their underlying type or runtime facility is absent.)

$(H2 $(LNAME2 classproperties, User-Defined Properties (Excluded)))

$(LASER_EXCLUDED The $(D @property) attribute is rejected on free functions,
methods, templates, getters, setters, immutable receivers, and UFCS functions.
Calling a function without parentheses is also rejected independently.)

$(SPEC_SUBNAV_PREV_NEXT type, Types, attribute, Attributes)
)

Macros:
        CHAPTER=8
        TITLE=Compiler-Provided Properties
