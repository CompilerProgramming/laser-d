Ddoc

$(SPEC_S Interfaces (Excluded),

$(HEADERNAV_TOC)

$(LASER_NORMATIVE Interfaces are not part of Laser-D. The frontend recognizes
interface syntax only to issue a Laser-D diagnostic; an interface declaration
does not create a type, contract, method table, or conversion relationship.)

$(H2 $(LNAME2 rejected-declarations, Rejected Interface Declarations))

$(LASER_EXCLUDED The rejection applies to every interface declaration in
Laser-D source, including:)

$(UL
$(LI forward declarations and definitions,)
$(LI plain and explicit $(D extern(D)) interfaces,)
$(LI templated and nested interfaces,)
$(LI interfaces with base-interface lists,)
$(LI the magic COM $(D IUnknown) root and interfaces derived from it,)
$(LI Objective-C protocols expressed through
$(D extern(Objective-C)) linkage,)
$(LI interfaces declared with $(D extern(C++)) linkage, including explicit
C++ class-mangling forms.)
)

$(P Rejecting an interface declaration before its body is analyzed does not
make any methods, aliases, templates, or nested declarations within the body
available to Laser-D source.)

$(H2 $(LNAME2 unavailable-model, Unavailable Interface Model))

$(LASER_EXCLUDED Because interface types do not exist, Laser-D has no:)

$(UL
$(LI interface inheritance or implementation declarations,)
$(LI implicit conversion from a value to an interface reference,)
$(LI interface references, virtual method tables, or adjustment thunks,)
$(LI runtime interface discovery, querying, downcasts, or upcasts,)
$(LI COM reference-counting conventions derived from $(D IUnknown),)
$(LI Objective-C protocol dispatch,)
$(LI C++ abstract-class ABI compatibility,)
$(LI interface $(D TypeInfo), identity comparisons, or class recovery.)
)

$(P BetterC mode alone does not define a portable, runtime-free interface
subset. Interface representation and dispatch depend on the selected object
model and ABI, while D interface conversions and metadata also depend on
facilities excluded from Laser-D.)

$(H2 $(LNAME2 structural-protocols, Explicit Structural Protocols))

$(P A supported language feature may validate a documented set of ordinary
struct methods without creating an interface type. Range iteration is the
principal example: the compiler checks the required range operations on the
concrete value and lowers the loop to explicit method calls.)

$(P Such validation is feature-specific and structural. It does not create a
common reference type, virtual dispatch, implicit conversion, or runtime
interface query.)

$(H2 $(LNAME2 explicit-dispatch, Explicit Dispatch))

$(P Programs that require runtime-selected behavior may represent it explicitly
with a context pointer and function pointers. The layout and ownership are then
ordinary program data rather than a hidden language interface.)

$(D_CODE
struct Operations
{
    extern(C) int function(void* context, int value) apply;
}

struct OperationHandle
{
    void* context;
    Operations* operations;
}

int invoke(ref OperationHandle handle, int value)
{
    return handle.operations.apply(handle.context, value);
}
)

$(P The program is responsible for ensuring that the context, operation table,
and selected functions remain valid. Laser-D does not add null checking,
lifetime management, synchronization, or ownership transfer.)

$(H2 $(LNAME2 foreign-interfaces, Foreign Interfaces))

$(P Foreign object systems may be accessed through an explicitly declared
C-style API using opaque pointers and free functions. Declaring such functions
does not enable D, COM, Objective-C, or C++ interface syntax or ABI lowering.)

$(P ImportC input retains its separately reviewed C declaration rules. A C
structure containing function pointers remains a C data layout, not a
Laser-D interface.)

$(SPEC_SUBNAV_PREV_NEXT class, Classes, enum, Enums)
)

