Ddoc

$(SPEC_S Types,

$(HEADERNAV_TOC)

$(LASER_NORMATIVE Laser-D is statically typed. Every expression has a type,
and every type has a compile-time-known size and representation except
$(D void), opaque enums awaiting definition, and incomplete ImportC types.
The language has no runtime type-information requirement.)

$(H2 $(LNAME2 grammar, Grammar))

$(GRAMMAR
$(GNAME Type):
    $(GLINK TypeCtors)$(OPT) $(GLINK BasicType) $(GLINK TypeSuffixes)$(OPT)

$(GNAME TypeCtors):
    $(GLINK TypeCtor)
    $(GLINK TypeCtor) $(GSELF TypeCtors)

$(GNAME TypeCtor):
    $(D const)
    $(D immutable)

$(GNAME BasicType):
    $(GLINK FundamentalType)
    $(D .) $(GLINK QualifiedIdentifier)
    $(GLINK QualifiedIdentifier)
    $(GLINK Typeof)
    $(GLINK Typeof) $(D .) $(GLINK QualifiedIdentifier)
    $(GLINK TypeCtor) $(D $(LPAREN)) $(GLINK Type) $(D $(RPAREN))
    $(GLINK2 traits, TraitsExpression)

$(GNAME FundamentalType):
    $(D void)
    $(GLINK ArithmeticType)

$(GNAME ArithmeticType):
    $(D bool)
    $(D byte)
    $(D ubyte)
    $(D short)
    $(D ushort)
    $(D int)
    $(D uint)
    $(D long)
    $(D ulong)
    $(D char)
    $(D wchar)
    $(D dchar)
    $(D float)
    $(D double)

$(GNAME TypeSuffixes):
    $(GLINK TypeSuffix) $(GSELF TypeSuffixes)$(OPT)

$(GNAME TypeSuffix):
    $(D *)
    $(D [ ])
    $(D [) $(GLINK2 expression, AssignExpression) $(D ])
    $(D [) $(GLINK2 expression, AssignExpression) $(D ..) $(GLINK2 expression, AssignExpression) $(D ])
    $(D delegate) $(GLINK2 function, Parameters)
    $(D function) $(GLINK2 function, Parameters)

$(GNAME QualifiedIdentifier):
    $(GLINK_LEX Identifier)
    $(GLINK_LEX Identifier) $(D .) $(GSELF QualifiedIdentifier)
    $(GLINK2 template, TemplateInstance)
    $(GLINK2 template, TemplateInstance) $(D .) $(GSELF QualifiedIdentifier)
    $(GLINK_LEX Identifier) $(D [) $(GLINK2 expression, AssignExpression) $(D])
    $(GLINK_LEX Identifier) $(D [) $(GLINK2 expression, AssignExpression) $(D] .) $(GSELF QualifiedIdentifier)
)

$(P A bracket suffix with no expression forms a non-owning slice. A suffix
with one compile-time expression forms a fixed-size array, or indexes a
compile-time type sequence where that interpretation applies. The range form
slices a compile-time type sequence.)

$(LASER_EXCLUDED A bracket suffix containing a type would form a D associative
array and is not in the grammar. Vector and string-mixin types are also omitted.
Function and delegate attributes are implicit or are specified on parameters as
defined by the functions chapter.)

$(H2 $(LEGACY_LNAME2 Basic Data Types, basic-data-types, Fundamental Types))

$(TABLE_3COLS Fundamental Types,
$(THEAD Type, $(D .init), Meaning)
$(TROW $(RELATIVE_LINK2 void, $(D void)), no value, function with no result)
$(TROW $(RELATIVE_LINK2 bool, $(D bool)), $(D false), Boolean)
$(TROW $(D byte), $(D 0), signed 8-bit integer)
$(TROW $(D ubyte), $(D 0u), unsigned 8-bit integer)
$(TROW $(D short), $(D 0), signed 16-bit integer)
$(TROW $(D ushort), $(D 0u), unsigned 16-bit integer)
$(TROW $(D int), $(D 0), signed 32-bit integer)
$(TROW $(D uint), $(D 0u), unsigned 32-bit integer)
$(TROW $(D long), $(D 0L), signed 64-bit integer)
$(TROW $(D ulong), $(D 0uL), unsigned 64-bit integer)
$(TROW $(D float), $(D float.nan), IEEE-754 binary32)
$(TROW $(D double), $(D double.nan), IEEE-754 binary64)
$(TROW $(D char), $(D '\xFF'), UTF-8 code unit)
$(TROW $(D wchar), $(D '\uFFFF'), UTF-16 code unit)
$(TROW $(D dchar), $(D '\U0000FFFF'), UTF-32 code unit)
$(TROW $(D typeof(null)), $(D null), null-literal type)
$(TROW $(RELATIVE_LINK2 noreturn, $(D noreturn)), no value, bottom type)
)

$(P Integer representation, alignment, and byte order follow the target ABI.
The supported initial targets use two's-complement integers. Character types
are distinct unsigned integral types; their values are code units and are not
automatically validated as complete Unicode scalar values.)

$(LASER_EXCLUDED $(D real), $(D cent), $(D ucent), $(D ifloat),
$(D idouble), $(D ireal), $(D cfloat), $(D cdouble), and $(D creal) are not
Laser-D types. ImportC may retain internal representations required for C
$(D long double) and other C declarations.)

$(H3 $(LNAME2 void, $(D void)))

$(P $(D void) denotes the absence of a value. It is valid as a function result
and as the target of a pointer, but an object or parameter cannot have type
$(D void). A $(D void*) may point to storage of any object type.)

$(H3 $(LNAME2 bool, $(D bool)))

$(P $(D bool) has the values $(D false) and $(D true). Converting zero or a null
pointer to $(D bool) yields $(D false); converting any other supported scalar
value yields $(D true). Converting $(D bool) to an integer yields zero or one.)

$(H2 $(LEGACY_LNAME2 Derived Data Types, derived-data-types, Derived Types))

$(UL
$(LI $(RELATIVE_LINK2 pointers, Pointers))
$(LI $(DDSUBLINK spec/arrays, static-arrays, Fixed-size arrays))
$(LI $(DDSUBLINK spec/arrays, dynamic-arrays, Non-owning slices))
$(LI $(RELATIVE_LINK2 function-pointers, Function pointers))
$(LI $(RELATIVE_LINK2 delegates, Restricted delegates))
$(LI $(DDLINK spec/const3, Type Qualifiers, Immutable types))
$(LI Compile-time type sequences produced by templates)
)

$(H3 $(LNAME2 component-types, Component Types))

$(P A pointer, fixed array, or slice has an element or pointed-to component
type. A function type has a result type and parameter types. A delegate has the
same function signature plus a context pointer. Applying $(D immutable) to a
compound value is transitive through all of its stored components.)

$(H3 $(LNAME2 pointers, Pointers))

$(P A value of type $(D T*) is either $(D null) or an address interpreted as
pointing to a $(D T). Pointer validity, alignment, provenance, object lifetime,
and bounds are programmer responsibilities. Dereferencing an invalid pointer
has undefined behavior.)

--------------------
int value = 3;
int* pointer = &value;
*pointer = 4;
--------------------

$(P Pointers provide explicit access to external allocation and C APIs. Laser-D
does not associate ownership or garbage collection with a pointer.)

$(H2 $(LEGACY_LNAME2 User Defined Types, user-defined-types, User-Defined Types))

$(P Laser-D user-defined runtime value types are structs, unions, and enums.
Templates may generate or transform any supported type. Aliases introduce
another name for a type but do not create a distinct type.)

$(LASER_EXCLUDED Native D classes and interfaces, C++ structs and classes, COM
interfaces, and Objective-C object types cannot be declared by Laser-D source.
ImportC retains C struct, union, enum, and incomplete types.)

$(H2 $(LNAME2 type-conversions, Type Conversions))

$(P A conversion is permitted only when both source and destination types are
supported. No conversion may introduce allocation, runtime type information,
class dispatch, or a rejected qualifier.)

$(H3 $(LEGACY_LNAME2 Implicit Conversions, implicit-conversions, Implicit Conversions))

$(UL
$(LI Integral values may widen to a type that represents their complete value
range.)
$(LI Compile-time constants may convert to an integral type when the value is
representable.)
$(LI $(D float) may convert to $(D double).)
$(LI A pointer may convert to $(D void*) while preserving qualification.)
$(LI $(D null) may convert to a pointer, slice, function pointer, or delegate.)
$(LI Fixed arrays, slices, function pointers, and delegates use the conversion
rules in their dedicated chapters.)
)

$(P Other numeric narrowing and reinterpretation requires an explicit cast.
An explicit cast still cannot name or produce an excluded Laser-D type.)

$(H3 $(LEGACY_LNAME2 Pointer Conversions, pointer-conversions, Pointer Conversions))

$(P A pointer to an object type implicitly converts to $(D void*). Converting a
$(D void*) back to another pointer type requires an explicit cast. Conversion
does not adjust alignment, extend lifetime, or establish that the destination
object exists.)

$(H3 $(LEGACY_LNAME2 Integer Promotions, integer-promotions, Integer Promotions))

$(P Integer promotions used by arithmetic convert $(D bool), $(D byte),
$(D ubyte), $(D short), $(D ushort), $(D char), and $(D wchar) to $(D int).
$(D dchar) promotes to $(D uint). Larger integer types retain their rank.)

$(H3 $(LEGACY_LNAME2 Usual Arithmetic Conversions, usual-arithmetic-conversions, Arithmetic Conversions))

$(P Binary arithmetic first applies integer promotion. If either operand is
$(D double), the other numeric operand converts to $(D double); otherwise if
either operand is $(D float), the other converts to $(D float). Integral
operands then convert to the common signed or unsigned type determined by their
rank and representable range.)

$(P Arithmetic never promotes to $(D real), imaginary, complex, or vector
types. Enum arithmetic is limited by the enum rules.)

$(H3 $(LNAME2 enum-ops, Enum Operations))

$(P Enum values retain their enum type except where the enum chapter permits
conversion to or from the base type. Unsupported automatic numbering or
arithmetic is diagnosed at compile time.)

$(H3 $(LNAME2 covariance, Function Type Compatibility))

$(P Function pointers and delegates are compatible only when their calling
convention, parameter passing, and result types satisfy the functions chapter.
Laser-D has no class covariance and rejects reference results.)

$(H2 $(LNAME2 functions, Function Types))

$(GRAMMAR
$(GNAME FunctionType):
    $(GLINK Type) $(D function) $(GLINK2 function, Parameters)
    $(GLINK Type) $(D delegate) $(GLINK2 function, Parameters)
)

$(P Every function type is implicitly $(D nothrow), $(D @nogc), and
$(D @system). These attributes cannot be written explicitly. Function types
are conservatively impure. Parameters may use only the annotations allowed by
the functions chapter, and results are returned by value.)

$(H3 $(LNAME2 function-pointers, Function Pointers))

$(P A function pointer contains a code address and no context. A null function
pointer cannot be called.)

--------------------
int addOne(int value) { return value + 1; }
int function(int) operation = &addOne;
--------------------

$(H3 $(LNAME2 delegates, Delegates))

$(P A delegate contains a function pointer and a context pointer. Laser-D
supports delegates bound to struct methods and delegate values whose context
does not capture an enclosing local variable. The value itself is fixed-size
and does not allocate.)

$(LASER_EXCLUDED A delegate literal or nested function that captures an
enclosing local variable is rejected, regardless of whether D could place its
closure on the stack or heap.)

$(H2 $(LNAME2 typeof, $(D typeof)))

$(GRAMMAR
$(GNAME Typeof):
    $(D typeof $(LPAREN)) $(GLINK2 expression, Expression) $(D $(RPAREN))
    $(D typeof $(LPAREN)) $(D return) $(D $(RPAREN))
)

$(P $(D typeof(expression)) yields the compile-time type of an expression
without evaluating it. $(D typeof(return)) yields the current function's result
type. The resulting type remains subject to all Laser-D restrictions.)

$(H3 $(LNAME2 typeof-this, $(D typeof(this))))

$(P Inside a struct or union, $(D typeof(this)) denotes the containing aggregate
type. Laser-D has no class inheritance, and $(D typeof(super)) is rejected.)

$(H2 $(LNAME2 runtime_type_information, No Runtime Type Information))

$(LASER_EXCLUDED Laser-D does not generate or expose $(D TypeInfo), class
metadata, or runtime type identifiers. Compile-time operations such as
$(D typeof), $(D is), templates, and supported $(D __traits) queries inspect
frontend types without requiring runtime metadata.)

$(H2 $(LNAME2 mixin_types, String Mixin Types))

$(LASER_EXCLUDED String mixin types are not part of Laser-D. Template mixins
operate on parsed declarations and remain available under their own chapter.)

$(H2 $(LNAME2 aliased-types, Conventional Type Aliases))

$(H3 $(LNAME2 size_t, $(D size_t)))

$(P $(D size_t) is the unsigned integer type capable of representing the size
of any addressable object. Its concrete fundamental type is target-dependent.)

$(H3 $(LNAME2 ptrdiff_t, $(D ptrdiff_t)))

$(P $(D ptrdiff_t) is the signed integer type corresponding in width to
$(D size_t). Its concrete fundamental type is target-dependent.)

$(H3 $(LNAME2 string, Character Slice Aliases))

$(P $(D string), $(D wstring), and $(D dstring) are
conventional aliases for immutable character slices normally supplied by
$(D object.d). They are not owning string types.)

$(H3 $(LNAME2 noreturn, $(D noreturn)))

$(P $(D noreturn), defined as $(D typeof(*null)), is the bottom type. No value
of this type is produced, and it implicitly converts to any result type. A
function inferred never to return may have this result type without requiring
exception support.)

$(SPEC_SUBNAV_PREV_NEXT declaration, Declarations, property, Properties)
)

Macros:
    CHAPTER=7
    TITLE=Types
