Ddoc

$(D_S Type Qualifiers,

$(HEADERNAV_TOC)

$(P Laser-D supports $(D immutable) as its sole source-level type qualifier.
It retains D's transitive immutable semantics: after initialization, an
immutable value and every value reachable through it cannot be modified.)

$(LASER_REJECTED The D qualifiers $(D const), $(D inout), and $(D shared) are
not supported in Laser-D source. ImportC retains the C qualifiers required to
represent and compile C declarations; that does not make those spellings
available to Laser-D modules.)

$(H2 $(LNAME2 Type, Qualifier Grammar))

$(GRAMMAR
$(GNAME ImmutableType):
    $(D immutable $(LPAREN)) $(GLINK2 type, Type) $(D $(RPAREN))
    $(D immutable) $(GLINK2 type, Type)
)

$(P The prefix storage-class form and the type-constructor form describe the
same immutable type where both grammars are valid.)

---
immutable int first = 1;
immutable(int) second = 2;
---

$(H2 $(LNAME2 const_and_immutable, Mutable and Immutable Values))

$(P An unqualified Laser-D value is mutable unless another rule makes the
particular storage unmodifiable. An $(D immutable) value is initialized once
and cannot subsequently be assigned or mutated.)

$(P Immutability is transitive. Applying $(D immutable) to a pointer, slice,
fixed array, or aggregate applies to its reachable components and fields, not
only to the outer reference value.)

---
struct Pair
{
    int first;
    int second;
}

immutable Pair pair = Pair(1, 2);
// pair.first = 3; // rejected
---

$(P $(D immutable) means permanently unmodifiable, not merely read-only through
one reference. Laser-D intentionally has no source qualifier corresponding to
D's aliasable read-only $(D const) view.)

$(H2 $(LNAME2 immutable_storage_class, Immutable Declarations))

$(P An immutable declaration requires a valid initializer unless the type has a
usable default value and the declaration context permits default
initialization. Type inference from the initializer is supported.)

$(SPEC_RUNNABLE_EXAMPLE_COMPILE
---
immutable int explicitType = 3;
immutable inferredType = 4;

static assert(is(typeof(inferredType) == immutable(int)));
---
)

$(P A local immutable value may be initialized by a runtime expression. The
initializer is evaluated before the value becomes available for ordinary use.)

$(SPEC_RUNNABLE_EXAMPLE_COMPILE
---
int next(int value)
{
    return value + 1;
}

int calculate(int input)
{
    immutable int result = next(input);
    return result;
}
---
)

$(P Runtime initialization does not make a value a compile-time constant. Use a
manifest $(D enum) when the declaration must exist only at compile time.)

$(H3 $(LNAME2 immutable-static-storage, Immutable Static Storage))

$(P Deeply immutable module, aggregate-static, and function-static values are
permitted when their initializers satisfy Laser-D's static-initialization
rules. They require no mutable static storage or module lifecycle function.)

$(LASER_REJECTED An immutable static declaration cannot defer initialization to
a module constructor. Module constructors, including shared module
constructors, are rejected.)

$(H2 $(LNAME2 const_storage_class, Rejected `const` Storage Class))

$(LASER_REJECTED The $(D const) storage class and $(D const(Type)) constructor
are rejected. Use $(D immutable) only when the value can never change, or use an
ordinary mutable type and an explicit API that does not mutate it.)

$(H2 $(LNAME2 immutable_type, Immutable Types))

$(P $(D immutable(Type)) forms the transitively immutable form of a supported
type. Applying it repeatedly has no additional effect.)

---
alias ImmutableInt = immutable(int);
alias ImmutablePair = immutable(Pair);
---

$(P A rejected type does not become available merely by qualifying it. For
example, immutable classes, associative arrays, and rejected scalar types
remain unavailable.)

$(H2 $(LNAME2 creating_immutable_data, Creating Immutable Data))

$(P Immutable scalar and value-type data is created by initializing its final
storage from a compatible expression. Ordinary value-copyable structs may be
copied into immutable destination storage without invoking a copy or move
constructor, because those constructors are rejected.)

$(P For pointers and slices, the compiler must not create an immutable view of
storage that remains mutable through another live alias. Consequently, a
mutable pointer or slice does not generally convert implicitly to its immutable
counterpart. Static string literal storage is already immutable and may be
viewed through an immutable character slice.)

$(H2 $(LNAME2 removing_with_cast, Casts and Immutability))

$(P A cast can change the static type the compiler uses for an expression, but
it cannot make modification of genuinely immutable storage valid. Writing
through a cast that removes $(D immutable) has undefined behavior and may fail
on read-only storage.)

$(P A cast is therefore not an ownership or mutability transfer. Programs that
need mutable data must create or receive mutable storage explicitly.)

$(H2 $(LNAME2 immutable_member_functions, Immutable Member Functions))

$(P A struct or union method may declare an immutable receiver by writing
$(D immutable) after its parameter list. Such a method can be called on an
immutable value and cannot modify its fields.)

$(SPEC_RUNNABLE_EXAMPLE_COMPILE
---
struct Value
{
    int number;

    int read() immutable
    {
        return number;
    }
}

int inspect()
{
    immutable Value value = Value(7);
    return value.read();
}
---
)

$(P Overload resolution may distinguish mutable and immutable receiver methods.
The rejected $(D const), $(D inout), and $(D shared) receiver forms are not
candidates.)

$(H2 $(LNAME2 const_type, Rejected `const` Type))

$(LASER_REJECTED $(D const(Type)) and every derived type containing source-level
$(D const) are rejected in Laser-D modules.)

$(H2 $(LNAME2 const_member_functions, Rejected `const` Methods))

$(LASER_REJECTED A member function cannot have a $(D const) receiver. Use a
mutable receiver for a normal method or an $(D immutable) receiver for a value
that is permanently immutable.)

$(H2 $(LNAME2 inout, Rejected `inout`))

$(LASER_REJECTED The $(D inout) qualifier, wildcard qualifier matching, and
$(D inout) receiver/parameter/return forms are rejected. Laser-D has no need to
abstract over a mutable/const/immutable qualifier family that it does not
provide.)

$(H2 $(LNAME2 shared, Rejected `shared`))

$(LASER_REJECTED The $(D shared) qualifier is rejected as part of Laser-D's
rejection of native D multithreading. C threading and atomic facilities may be
used through explicit C interoperability.)

$(H3 $(LNAME2 shared_cast, Shared Casts))

$(P Casts cannot introduce or remove $(D shared), because the qualifier itself
is unavailable in Laser-D source.)

$(H3 $(LNAME2 shared_global, Shared Global Variables))

$(P $(D shared) globals and shared module lifecycle functions are rejected.
Mutable global storage is independently rejected.)

$(H2 $(LNAME2 combining_qualifiers, Qualifier Composition))

$(P Because $(D immutable) is the only retained qualifier, Laser-D has no source
syntax for composing it with $(D const), $(D inout), or $(D shared).
Immutability still composes normally with supported pointers, arrays, slices,
aggregates, function signatures, aliases, and templates.)

$(H2 $(LNAME2 implicit_qualifier_conversions, Immutable Conversions))

$(P A mutable scalar or ordinary value-copyable aggregate expression may
initialize separate immutable value storage when the conversion copies the
value and leaves no mutable alias to the immutable destination.)

$(P An immutable value may be read, copied to another compatible immutable
value, passed to an immutable parameter or receiver, and explicitly converted
to a compatible scalar value where the ordinary conversion rules permit. It
does not implicitly convert to a mutable reference, pointer, or slice.)

$(H3 $(LNAME2 unique-expressions, Unique Expressions))

$(P Upstream D uses uniqueness analysis to permit some mutable-to-immutable
reference conversions. Laser-D's rejected allocation and owning-array features
remove the common implicit-uniqueness cases. No general ownership transfer is
implied: conversions involving pointers or slices must preserve the rule that
immutable storage has no mutable alias.)

$(H2 $(LNAME2 importc-qualifiers, ImportC Qualifiers))

$(P ImportC preserves C $(D const) and the frontend representation required for
the reviewed C baseline. Other C qualifications, including atomic forms, remain
subject to the ImportC audit. No ImportC qualifier enables corresponding
D-source syntax or semantics in a Laser-D module.)

$(H2 $(LNAME2 conformance, Conformance Boundary))

$(P Laser-D qualifier conformance consists of transitive $(D immutable), local
runtime initialization, eligible static immutable initialization, immutable
receiver methods, and conversions that preserve permanent immutability.
Source-level $(D const), $(D inout), and $(D shared), mutable aliases to immutable
storage, and module-lifecycle initialization are rejected.)

$(SPEC_SUBNAV_PREV_NEXT enum, Enums, function, Functions)
)

Macros:
    TITLE=Type Qualifiers
    CATEGORY_SPEC=$0
